---
// Shared detail-panel shell used by both the org-detail sidebar (HomeDetailPanel.astro) and the
// ontology-detail sidebar (OntologyGallery.astro) — one component, one CSS definition, so their
// container chrome (position, size, border, radius, shadow, header layout) can't drift apart the
// way it did before this was extracted: the org panel had ended up a floating rounded card while
// the ontology panel had ended up a flush, square-cornered, full-height drawer, despite both
// being "the same kind of sidebar." Content is entirely up to the consumer via the default
// slot — this only owns the shell and the one behavior that's identical everywhere it's used:
// how the panel closes (✕ button, Escape key, click-inside doesn't bubble to a page-level
// click-outside handler).
// Nav (Layout.astro) is position:sticky at a fixed 48px tall — reused here so a position:fixed
// panel insets below it instead of overlapping it. Not needed for position:absolute panels: those
// live inside their own container that's already positioned below the nav (see the position prop
// doc below), so their top:0.5rem is relative to that container, not the viewport.
const NAV_HEIGHT = '48px';

export interface Props {
  panelId: string;
  // 'fixed' (default) pins the panel to the viewport, needed on pages that scroll under it
  // (e.g. the /ontology listing page — a normal tall page with no height-constrained wrapper, so
  // an absolutely-positioned panel would just scroll away with the content). 'absolute' is for
  // panels living inside their own position:relative container that's already sized to fill
  // exactly the viewport height below the nav and doesn't itself scroll (the home page's
  // map/gallery view) — the two aren't interchangeable, but every other visual property below
  // (size, border, radius, shadow, header) is shared regardless of which is used.
  position?: 'fixed' | 'absolute';
  // The home page's panel is visible by default (showing welcome content) the instant the page
  // loads, rather than waiting on index.astro's own script to call open() — that call can race
  // this component's script on first paint, so the default has to be correct without it.
  initiallyOpen?: boolean;
}
const { panelId, position = 'fixed', initiallyOpen = false } = Astro.props;
const topInset = position === 'fixed' ? `calc(${NAV_HEIGHT} + 0.5rem)` : '0.5rem';
---

<div id={panelId} class="detail-side-panel" style={`display:${initiallyOpen ? 'flex' : 'none'};position:${position};top:${topInset};`}>
  <div class="detail-side-panel-header">
    <a id={`${panelId}-viewfull`} href="#" class="detail-side-panel-viewfull" aria-label="View full page">→ View full page</a>
    <button id={`${panelId}-close`} type="button" class="detail-side-panel-close" aria-label="Close panel">✕</button>
  </div>
  <div id={`${panelId}-content`} class="detail-side-panel-content">
    <slot />
  </div>
</div>

<style is:global>
  .detail-side-panel {
    /* top is set per-instance inline (see topInset above) since it depends on position mode. */
    right: 0.5rem;
    bottom: 0.5rem;
    width: 460px;
    max-width: 45%;
    background: color-mix(in srgb, var(--paper-50) 98%, transparent);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(42, 24, 16, 0.12);
    font-family: var(--sans);
    /* Below the nav's z-index:50 (Layout.astro) so it can never render on top of it, even at
       viewport sizes where the panel would otherwise reach that high. */
    z-index: 40;
    flex-direction: column;
  }
  .detail-side-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }
  .detail-side-panel-viewfull {
    /* Hidden until a consumer has an actual page to link to and reveals it (each one owns its
       own welcome-vs-detail state, so this can't default to visible here). */
    display: none;
    color: var(--muted);
    font-size: 0.75rem;
    font-family: var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    text-decoration: none;
  }
  .detail-side-panel-close {
    background: none;
    border: none;
    color: var(--muted);
    font-size: 1.1rem;
    cursor: pointer;
    line-height: 1;
    padding: 0;
  }
  .detail-side-panel-content {
    padding: 1.25rem;
    overflow-y: auto;
    flex: 1;
  }
</style>

<script>
  // Generic close-button + Escape-key + no-bubble wiring for every .detail-side-panel on the
  // page. Opening and populating content stays each consumer's own job (HomeDetailPanel.astro /
  // OntologyGallery.astro) since what "open" means differs there — welcome-vs-detail state,
  // which click triggers it, how content gets filled in — but closing is identical everywhere.
  function initPanel(panel: HTMLElement) {
    const closeBtn = document.getElementById(`${panel.id}-close`);
    closeBtn?.addEventListener('click', () => {
      panel.style.display = 'none';
    });
    // No click-stopPropagation here (there used to be one) — the actual click-outside-closes
    // logic below uses mousedown, not click, so it was never needed for that. What it did do,
    // as a side effect, was swallow every click inside the panel before it could bubble to
    // document — silently breaking any consumer's own document-level delegated click handling
    // for its panel content (e.g. OntologyDetail.astro's Tags/Organizations filter dropdowns,
    // which worked in full-page mode but were dead on arrival inside this panel — 2026-08-14).
  }

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll<HTMLElement>('.detail-side-panel').forEach((panel) => {
      panel.style.display = 'none';
    });
  });

  // Click-outside-closes, generic to every .detail-side-panel. Uses mousedown rather than click
  // for two reasons: (1) the click that *opens* a panel (a map marker, gallery card, ontology
  // theme card — all outside the panel by definition) fires its own listener first, then bubbles
  // to this one last during the bubble phase — by then the panel is already open, so a click-based
  // check here would immediately close what just opened. mousedown fires before that open logic
  // ever runs, so it never sees the panel as open on the same interaction. (2) on a map, a
  // mousedown that turns into a drag-to-pan shouldn't close the panel — MapLibre's own click event
  // already distinguishes a real click from a drag and handles panel state itself (see
  // HomeEarthMap.astro/EarthMap.astro), so map containers opt out here via
  // data-panel-outside-click="ignore" rather than double-handling the same interaction.
  document.addEventListener('mousedown', (e) => {
    const target = e.target as Node;
    if (target instanceof Element && target.closest('[data-panel-outside-click="ignore"]')) return;
    document.querySelectorAll<HTMLElement>('.detail-side-panel').forEach((panel) => {
      if (panel.style.display === 'none') return;
      if (panel.contains(target)) return;
      panel.style.display = 'none';
    });
  });

  function initAll() {
    document.querySelectorAll<HTMLElement>('.detail-side-panel').forEach(initPanel);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
</script>

---
import type { NormalizedRecord } from '../lib/notion';
import { getCoords, getScopeRadiusKm } from '../lib/geo';
import { toneForCategory } from '../lib/notion';

export interface Props {
  records?: Array<{
    id: string;
    url?: string;
    properties: Record<string, any>;
    sectionRoute?: string;
  }>;
  basePath?: string;
  lookups?: {
    tags?: Map<string, NormalizedRecord>;
  };
}
const { records = [], basePath = '/', lookups = {} } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function getTagNames(props: Record<string, any>): Array<{ name: string; icon?: string }> {
  const ids: string[] = Array.isArray(props['Tags']) ? props['Tags'] : [];
  return ids
    .map((id) => lookups.tags?.get(id))
    .filter(Boolean)
    .map((t) => ({ name: String(t!.properties['Name'] ?? t!.properties['Title'] ?? 'Untitled').replace(/_/g, ' '), icon: t!.icon }));
}

function formatValue(value: any): string {
  if (value === null || value === undefined) return '';
  if (Array.isArray(value)) return value.join(', ');
  if (typeof value === 'object') {
    if ('address' in value && value.address) return String(value.address);
    if ('name' in value && value.name) return String(value.name);
    if ('latitude' in value && 'longitude' in value) {
      return `${value.latitude}, ${value.longitude}`;
    }
    try {
      return JSON.stringify(value);
    } catch {
      return '[Object]';
    }
  }
  return String(value);
}

const markerResults = records.map((r) => {
  const coords = getCoords(r.properties);
  if (!coords) return { record: r, marker: null };
  const name = String(r.properties['Name'] ?? r.properties['Title'] ?? 'Untitled');
  const slug = r.id.replace(/-/g, '');
  const pathPrefix = r.sectionRoute ? r.sectionRoute.replace(/\/$/, '') : basePath.replace(/\/$/, '');
  const href = `${base}${pathPrefix}/${slug}`;
  const caseStudy = r.properties['Case Study'] ?? null;
  const place = String(
    r.properties['Place']?.address ??
    r.properties['Place']?.name ??
    r.properties['Place'] ??
    r.properties['Scope'] ??
    r.properties['scope'] ??
    r.properties['Location'] ??
    r.properties['location'] ??
    ''
  );
  const category = String(
    r.properties['Category'] ??
    r.properties['category'] ??
    r.properties['Type'] ??
    r.properties['type'] ??
    ''
  );
  const tags = getTagNames(r.properties).slice(0, 4);
  const categoryTone = category ? toneForCategory(category) : 'neutral';
  const scopeRadiusKm = getScopeRadiusKm(r.properties);
  return {
    record: r,
    marker: {
      id: r.id,
      lat: coords.lat,
      lng: coords.lng,
      name,
      href,
      url: r.url ?? null,
      properties: r.properties,
      caseStudy,
      place,
      category,
      categoryTone,
      tags,
      scopeRadiusKm,
    },
  };
});

const markers = markerResults.map((m) => m.marker).filter(Boolean) as Array<{
  id: string; lat: number; lng: number; name: string; href: string; url: string | null; properties: Record<string, any>; caseStudy: string | null; place: string; category: string; categoryTone: string; tags: Array<{ name: string; icon?: string }>; scopeRadiusKm: number;
}>;

// Work Item A: orgs without a resolvable lat/lng used to vanish from every map with zero
// indication (they'd still show up fine in Gallery, since that view is unfiltered) — surface
// the gap instead of silently dropping it. The actual fix for these specific records is adding
// Lat/Lng in Notion; this is a diagnostic only, not a workaround.
const missingCoordsRecords = markerResults.filter((m) => m.marker === null).map((m) => m.record);
if (missingCoordsRecords.length > 0) {
  const names = missingCoordsRecords.map((r) => String(r.properties['Name'] ?? r.properties['Title'] ?? r.id)).join(', ');
  console.warn(`[geo] ${missingCoordsRecords.length} record(s) missing coordinates, not shown on map: ${names}`);
}
---

<div style="position:relative;width:100%;height:480px;border-radius:var(--radius);overflow:hidden;border:1px solid var(--border);">
  <div id="earth-map" style="width:100%;height:100%;" data-markers={JSON.stringify(markers)}></div>

  <!-- Side panel. G6: header now carries "View full page" (was a button in the content area)
       for consistency with HomeEarthMap.astro's panel, next to Close. -->
  <div
    id="map-panel"
    style="display:none;position:absolute;top:0.5rem;right:0.5rem;bottom:0.5rem;width:460px;max-width:calc(100% - 1rem);background:color-mix(in srgb, var(--paper-50) 98%, transparent);backdrop-filter:blur(12px);border:1px solid var(--border);border-radius:var(--radius);padding:0;z-index:20;overflow:hidden;box-shadow:0 8px 32px rgba(42,24,16,0.12);font-family:var(--sans);"
  >
    <div style="display:flex;align-items:center;justify-content:space-between;padding:1rem 1.25rem;border-bottom:1px solid var(--border);">
      <a id="map-panel-viewfull" href="#" style="display:none;color:var(--muted);font-size:0.75rem;font-family:var(--mono);text-transform:uppercase;letter-spacing:0.03em;text-decoration:none;" aria-label="View full page">→ View full page</a>
      <button id="map-panel-close" style="background:none;border:none;color:var(--muted);font-size:1.1rem;cursor:pointer;line-height:1;padding:0;" aria-label="Close panel">✕</button>
    </div>
    <div id="map-panel-content" style="padding:1.25rem;overflow-y:auto;height:calc(100% - 52px);"></div>
  </div>
</div>

<style is:global>
  /* Same 1.5rem edge inset as the view toggle uses on the home map (HomeEarthMap.astro), for
     consistency — MapLibre's own default is a plain 10px margin. */
  .maplibregl-ctrl-bottom-left {
    margin: 1.5rem !important;
  }
</style>

<script>
  import maplibregl from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';
  import { createLedMarkerElement, colorVarForMarker, addScopeCirclesLayer } from '../lib/mapMarkerStyle';

  function renderProperties(props) {
    const entries = Object.entries(props).filter(([key, value]) => {
      if (value === null || value === undefined || value === '' || (Array.isArray(value) && value.length === 0)) return false;
      return true;
    });
    if (entries.length === 0) return '';

    function fmt(v) {
      if (v === null || v === undefined) return '';
      if (Array.isArray(v)) return v.join(', ');
      if (typeof v === 'object') {
        if ('address' in v && v.address) return String(v.address);
        if ('name' in v && v.name) return String(v.name);
        if ('latitude' in v && 'longitude' in v) return `${v.latitude}, ${v.longitude}`;
        try { return JSON.stringify(v); } catch { return '[Object]'; }
      }
      return String(v);
    }

    return `<dl style="display:grid;grid-template-columns:1fr;gap:0.85rem;margin:0;">
      ${entries.map(([key, value]) => {
        const display = fmt(value);
        return `<div style="display:grid;grid-template-columns:120px 1fr;gap:0.6rem;align-items:start;">
          <dt style="font-size:0.7rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em;padding-top:0.15rem;font-family:var(--mono);">${key}</dt>
          <dd style="margin:0;font-size:0.85rem;color:var(--fg);word-break:break-word;line-height:1.45;">${display}</dd>
        </div>`;
      }).join('')}
    </dl>`;
  }

  function initMap() {
    const mapContainer = document.getElementById('earth-map');
    if (!mapContainer) return;

    const markers = JSON.parse(mapContainer.dataset.markers || '[]');
    if (markers.length === 0) {
      mapContainer.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--muted);font-size:0.9rem;font-family:var(--mono);">No geolocated records to display.</div>';
      return;
    }

    const avgLat = markers.reduce((s, m) => s + m.lat, 0) / markers.length;
    const avgLng = markers.reduce((s, m) => s + m.lng, 0) / markers.length;

    const map = new maplibregl.Map({
      container: mapContainer,
      style: {
        version: 8,
        sources: {
          osm: {
            type: 'raster',
            tiles: ['https://tile.openstreetmap.org/{z}/{x}/{y}.png'],
            tileSize: 256,
            attribution: '&copy; OpenStreetMap contributors',
          },
        },
        layers: [{ id: 'osm', type: 'raster', source: 'osm' }],
      },
      center: [avgLng || 0, avgLat || 20],
      zoom: markers.length === 1 ? 4 : 2,
    });

    // Grouped bottom-left (was split bottom-right/bottom-left) — consistent with
    // HomeEarthMap.astro, and clear of the missing-coordinates note, which now sits to the
    // right of this stack instead of overlapping it.
    map.addControl(new maplibregl.NavigationControl(), 'bottom-left');
    map.addControl(new maplibregl.FullscreenControl(), 'bottom-left');

    const bounds = new maplibregl.LngLatBounds();
    const panel = document.getElementById('map-panel');
    const panelContent = document.getElementById('map-panel-content');
    const panelClose = document.getElementById('map-panel-close');
    const panelViewFull = document.getElementById('map-panel-viewfull');

    function getDescription(props) {
      return String(props['description'] ?? props['Description'] ?? props['Notes'] ?? props['notes'] ?? '');
    }

    function showPanel(m) {
      if (!panel || !panelContent) return;
      const desc = getDescription(m.properties);
      const descHtml = desc ? `<p style="font-size:1rem;color:var(--fg);line-height:1.6;margin:0 0 1.25rem 0;">${desc}</p>` : '';
      const propsHtml = renderProperties(m.properties);

      panelContent.innerHTML = `
        <h2 style="font-size:clamp(1.4rem, 3vw, 1.8rem);font-weight:500;margin:0 0 0.75rem 0;color:var(--fg);line-height:1.2;letter-spacing:-0.01em;">${m.name}</h2>
        ${descHtml}
        <div style="border-radius:var(--radius);border:1px solid var(--border);background:var(--card);padding:1.25rem;">
          ${propsHtml}
        </div>
      `;
      if (panelViewFull) {
        panelViewFull.href = m.href;
        panelViewFull.style.display = 'inline-block';
      }
      panel.style.display = 'block';
    }

    function hidePanel() {
      if (panel) panel.style.display = 'none';
      if (panelViewFull) panelViewFull.style.display = 'none';
    }

    panelClose?.addEventListener('click', hidePanel);
    panel?.addEventListener('click', (e) => e.stopPropagation());

    // Scope circles need map.addSource/addLayer, which require the style to have finished
    // loading — unlike plain DOM markers below, which don't and are placed unconditionally
    // (matching this file's original behavior; gating marker placement itself on 'load' here
    // turned out to leave every marker unplaced — 'load' wasn't firing reliably in this
    // particular init path, unlike HomeEarthMap.astro's, so only the part that actually
    // requires it is gated).
    if (map.loaded()) {
      addScopeCirclesLayer(map, markers);
    } else {
      map.on('load', () => addScopeCirclesLayer(map, markers));
    }

    function placeMarkers() {
      for (const m of markers) {
        const marker = new maplibregl.Marker({
          element: createLedMarkerElement(colorVarForMarker(m)),
          anchor: 'center',
        })
          .setLngLat([m.lng, m.lat])
          .addTo(map);

        const popup = new maplibregl.Popup({
          offset: 18,
          closeButton: false,
          closeOnClick: false,
          className: 'map-pin-popup',
          maxWidth: '320px', // MapLibre's own default (240px) was overriding the inner div's
                              // max-width below, which is why tags were getting cut off
        }).setHTML(`
          <div style="padding:0.85rem 1rem;font-family:var(--sans);max-width:320px;">
            ${m.category || m.caseStudy === 'Y' ? `<div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;margin-bottom:0.75rem;">
              ${m.category ? `<span class="badge badge--xs badge--pill badge--${m.categoryTone}">${m.category}</span>` : '<span></span>'}
              ${m.caseStudy === 'Y' ? `<span style="font-family:var(--mono);font-size:0.6rem;text-transform:uppercase;letter-spacing:0.03em;color:var(--muted);"><span class="case-study-dot"></span>Case study</span>` : ''}
            </div>` : ''}
            <div style="font-weight:500;font-size:1.15rem;color:var(--fg);margin-bottom:0.5rem;line-height:1.3;">${m.name}</div>
            ${m.place ? `<div style="font-size:0.8rem;color:var(--muted);line-height:1.4;margin-bottom:0.75rem;">📍 ${m.place}</div>` : ''}
            ${(m.tags && m.tags.length) ? `<div style="display:flex;flex-wrap:wrap;gap:0.4rem;">
              ${m.tags.map((t) => `<span class="badge badge--sm badge--square badge--neutral">${t.icon ? t.icon + ' ' : ''}${t.name}</span>`).join('')}
            </div>` : ''}
          </div>
        `);
        marker.setPopup(popup);

        const markerEl = marker.getElement();
        markerEl.style.cursor = 'pointer';
        markerEl.addEventListener('mouseenter', () => marker.togglePopup());
        markerEl.addEventListener('mouseleave', () => marker.togglePopup());

        markerEl.addEventListener('click', (e) => {
          e.stopPropagation();
          showPanel(m);
        });

        bounds.extend([m.lng, m.lat]);
      }

      if (markers.length > 1) {
        map.fitBounds(bounds, { padding: 40, maxZoom: 8 });
      }
    }

    placeMarkers();

    map.on('click', hidePanel);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMap);
  } else {
    initMap();
  }
</script>

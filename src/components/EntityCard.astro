---
import Badge from './Badge.astro';

export interface Props {
  id: string;
  title: string;
  subtitle?: string;
  tags?: string[];
  url?: string | null;
  basePath?: string;
}
const { id, title, subtitle, tags = [], url, basePath = '/' } = Astro.props;
const slug = id.replace(/-/g, '');
const base = import.meta.env.BASE_URL;
const cleanBasePath = basePath.endsWith('/') ? basePath.slice(0, -1) : basePath;
const href = `${base}${cleanBasePath}/${slug}`;
---

<a
  href={href}
  class="entity-card"
  style="display:block;border-radius:var(--radius);border:1px solid var(--border);background:var(--card);padding:1.25rem;text-decoration:none;transition:transform 0.15s ease,border-color 0.15s ease,box-shadow 0.15s ease;"
>
  <h3 style="margin:0 0 0.4rem 0;font-size:1.15rem;font-weight:500;color:var(--fg);line-height:1.35;font-family:var(--sans);">{title}</h3>
  {subtitle && <p style="margin:0 0 0.75rem 0;font-size:0.875rem;color:var(--muted);line-height:1.45;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{subtitle}</p>}
  <div style="display:flex;flex-wrap:wrap;gap:0.4rem;margin-bottom:0.5rem;">
    {tags.slice(0, 4).map((t) => (
      <Badge size="sm" shape="square">{t}</Badge>
    ))}
    {tags.length > 4 && (
      <Badge size="sm" shape="square">+{tags.length - 4}</Badge>
    )}
  </div>
  {url && (
    <p style="margin:0;font-size:0.78rem;color:var(--primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-family:var(--mono);">{url}</p>
  )}
</a>

<style>
  /* CSS-only hover (parity with OrganizationsGallery.astro's .gallery-card, Work Item F1) —
     the old onmouseenter/onmouseleave inline-style pattern could get stuck if a mouseleave
     event was interrupted. */
  .entity-card:hover {
    transform: translateY(-2px);
    border-color: var(--paper-200);
    box-shadow: 0 4px 20px rgba(42, 24, 16, 0.06);
  }
</style>

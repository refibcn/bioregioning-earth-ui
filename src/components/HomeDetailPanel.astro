---
// Extracted from HomeEarthMap.astro so the detail sidebar is a sibling of both #map-view and
// #gallery-view (in index.astro) rather than a descendant of #map-view. It used to be nested
// inside the map's own wrapper, so toggling #map-view to display:none for gallery view also
// hid the panel — meaning a gallery-card click correctly populated the panel but it stayed
// invisible. Now it's independent of which view is active and can overlay either one.
import type { NormalizedRecord } from '../lib/notion';
import OrgDetail from './OrgDetail.astro';
import Badge from './Badge.astro';

export interface Props {
  records?: Array<{
    id: string;
    url?: string;
    properties: Record<string, any>;
    sectionRoute?: string;
  }>;
  basePath?: string;
  orgCount?: number;
  lookups?: {
    tags?: Map<string, NormalizedRecord>;
    activities?: Map<string, NormalizedRecord>;
    sources?: Map<string, NormalizedRecord>;
    affiliations?: Map<string, NormalizedRecord>;
  };
  themes?: NormalizedRecord[];
}
const { records = [], basePath = '/', orgCount = 0, lookups = {}, themes = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const hasLookups = Object.keys(lookups).length > 0;
const themeCount = themes.length;

const hrefById: Record<string, string> = {};
for (const r of records) {
  const slug = r.id.replace(/-/g, '');
  const pathPrefix = r.sectionRoute ? r.sectionRoute.replace(/\/$/, '') : basePath.replace(/\/$/, '');
  hrefById[r.id] = `${base}${pathPrefix}/${slug}`;
}
---

<div
  id="home-panel"
  data-hrefs={JSON.stringify(hrefById)}
  style="position:absolute;top:0.5rem;right:0.5rem;bottom:0.5rem;width:460px;max-width:45%;background:color-mix(in srgb, var(--paper-50) 98%, transparent);backdrop-filter:blur(12px);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;box-shadow:0 8px 32px rgba(42,24,16,0.12);font-family:var(--sans);z-index:20;display:flex;flex-direction:column;"
>
  <div style="display:flex;align-items:center;justify-content:space-between;padding:0.875rem 1.25rem;border-bottom:1px solid var(--border);flex-shrink:0;">
    <a id="panel-viewfull-link" href="#" style="display:none;color:var(--muted);font-size:0.8rem;font-family:var(--mono);text-transform:uppercase;letter-spacing:0.03em;text-decoration:none;" aria-label="View full page">→ View full page</a>
    <button id="panel-close-btn" style="background:none;border:none;color:var(--muted);font-size:1.1rem;cursor:pointer;line-height:1;padding:0;" aria-label="Close panel">✕</button>
  </div>

  <div id="panel-content" style="padding:1.25rem;overflow-y:auto;flex:1;">
    <div id="panel-welcome">
      <h1 style="font-size:clamp(1.5rem, 2.5vw, 2rem);font-weight:500;margin:0 0 0.6rem 0;color:var(--fg);letter-spacing:-0.01em;line-height:1.2;">Welcome to Bioregioning Earth– a Bioregional Knowledge Commons</h1>
      <p style="color:var(--muted);margin:0 0 0.75rem 0;font-size:0.9rem;line-height:1.55;">This is a public knowledge base documenting organizations and practices at the frontier of bioregional work — exploring how communities around the world are learning to live and govern within the logic of place.</p>
      <p style="color:var(--muted);margin:0 0 0.75rem 0;font-size:0.75rem;font-family:var(--mono);text-transform:uppercase;letter-spacing:0.04em;">
        <strong style="color:var(--fg);">{orgCount}</strong> bioregional actors and initiatives currently mapped{themeCount > 0 && <> across <strong style="color:var(--fg);">{themeCount}</strong> themes:</>}
      </p>
      {themeCount > 0 && (
        <div style="display:flex;flex-wrap:wrap;gap:0.4rem;margin-bottom:1rem;">
          {themes.map((theme) => (
            <Badge shape="square" size="sm" icon={theme.icon} href={`${base}/ontology/${theme.id.replace(/-/g, '')}`}>
              {String(theme.properties['Name'] ?? theme.properties['Title'] ?? '').replace(/_/g, ' ')}
            </Badge>
          ))}
        </div>
      )}
    </div>

    <div id="panel-detail" style="display:none;"></div>
  </div>
</div>

{hasLookups && (
  <div style="display:none;">
    {records.map((r) => (
      <div id={`home-detail-${r.id}`} class="home-detail-template">
        <OrgDetail record={r} lookups={lookups} mode="panel" fullPageHref={hrefById[r.id]} />
      </div>
    ))}
  </div>
)}

<script>
  function initPanel() {
    const panelEl = document.getElementById('home-panel') as HTMLElement | null;
    if (!panelEl) return;
    const hrefs = JSON.parse(panelEl.dataset.hrefs || '{}');
    const hasLookups = document.querySelector('.home-detail-template') !== null;
    const welcomeDiv = document.getElementById('panel-welcome') as HTMLElement;
    const detailDiv = document.getElementById('panel-detail') as HTMLElement;
    const viewFullLink = document.getElementById('panel-viewfull-link') as HTMLAnchorElement | null;
    const closeBtn = document.getElementById('panel-close-btn');
    const contentDiv = document.getElementById('panel-content');

    function open() {
      panelEl!.style.display = 'flex';
    }
    function close() {
      panelEl!.style.display = 'none';
    }
    function showWelcome() {
      detailDiv.style.display = 'none';
      welcomeDiv.style.display = 'block';
      if (viewFullLink) viewFullLink.style.display = 'none';
      if (contentDiv) contentDiv.scrollTop = 0;
    }
    function showDetailById(id: string, name?: string) {
      open();
      welcomeDiv.style.display = 'none';
      const href = hrefs[id];
      if (viewFullLink) {
        if (href) viewFullLink.href = href;
        viewFullLink.style.display = 'inline-block';
      }
      if (hasLookups) {
        const template = document.getElementById(`home-detail-${id}`);
        detailDiv.innerHTML = template ? template.innerHTML : '<p style="color:var(--muted);">Detail not available.</p>';
      } else {
        detailDiv.innerHTML = `<h2 style="font-size:clamp(1.3rem, 2.5vw, 1.6rem);font-weight:500;margin:0 0 0.6rem 0;color:var(--fg);line-height:1.2;letter-spacing:-0.01em;">${name ?? ''}</h2>`;
      }
      detailDiv.style.display = 'block';
      if (contentDiv) contentDiv.scrollTop = 0;
    }

    closeBtn?.addEventListener('click', close);
    panelEl.addEventListener('click', (e) => e.stopPropagation());

    // Consumed by HomeEarthMap.astro (marker click/map-empty-click) and OrganizationsGallery.astro
    // (card click) — both live outside this component and need a shared way to drive the panel
    // regardless of which view (map/gallery) is currently active.
    (window as any).__bePanel = { showDetailById, showWelcome, open, close };
    // Theme badges are now plain links to their /ontology/{slug} page (Badge.astro's own href
    // prop), no click-wiring needed here anymore.
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPanel);
  } else {
    initPanel();
  }
</script>

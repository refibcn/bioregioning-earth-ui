---
import type { NormalizedRecord } from '../lib/notion';
import { toneForCategory } from '../lib/notion';
import { getCoords } from '../lib/geo';
import OrgDetail from './OrgDetail.astro';
import Badge from './Badge.astro';

export interface Props {
  records?: Array<{
    id: string;
    url?: string;
    properties: Record<string, any>;
    sectionRoute?: string;
  }>;
  basePath?: string;
  orgCount?: number;
  orgDescription?: string;
  lookups?: {
    tags?: Map<string, NormalizedRecord>;
    activities?: Map<string, NormalizedRecord>;
    sources?: Map<string, NormalizedRecord>;
    affiliations?: Map<string, NormalizedRecord>;
  };
  themes?: NormalizedRecord[];
}
const { records = [], basePath = '/', orgCount = 0, orgDescription = '', lookups = {}, themes = [] } = Astro.props;
const base = import.meta.env.BASE_URL;

function getTagNames(props: Record<string, any>): Array<{ name: string; icon?: string }> {
  const ids: string[] = Array.isArray(props['Tags']) ? props['Tags'] : [];
  return ids
    .map((id) => lookups.tags?.get(id))
    .filter(Boolean)
    .map((t) => ({ name: String(t!.properties['Name'] ?? t!.properties['Title'] ?? 'Untitled').replace(/_/g, ' '), icon: t!.icon }));
}

const markerResults = records.map((r) => {
  const coords = getCoords(r.properties);
  if (!coords) return { record: r, marker: null };
  const name = String(r.properties['Name'] ?? r.properties['Title'] ?? 'Untitled');
  const slug = r.id.replace(/-/g, '');
  const pathPrefix = r.sectionRoute ? r.sectionRoute.replace(/\/$/, '') : basePath.replace(/\/$/, '');
  const href = `${base}${pathPrefix}/${slug}`;
  const caseStudy = r.properties['Case Study'] ?? null;
  const place = String(
    r.properties['Place']?.address ??
    r.properties['Place']?.name ??
    r.properties['Place'] ??
    r.properties['Scope'] ??
    r.properties['scope'] ??
    r.properties['Location'] ??
    r.properties['location'] ??
    ''
  );
  const category = String(
    r.properties['Category'] ??
    r.properties['category'] ??
    r.properties['Type'] ??
    r.properties['type'] ??
    ''
  );
  const tags = getTagNames(r.properties).slice(0, 4);
  const categoryTone = category ? toneForCategory(category) : 'neutral';
  return {
    record: r,
    marker: { id: r.id, lat: coords.lat, lng: coords.lng, name, href, caseStudy, place, category, categoryTone, tags },
  };
});

const markers = markerResults.map((m) => m.marker).filter(Boolean) as Array<{
  id: string; lat: number; lng: number; name: string; href: string; caseStudy: string | null; place: string; category: string; categoryTone: string; tags: Array<{ name: string; icon?: string }>;
}>;

// Work Item A: see EarthMap.astro for the full explanation — same diagnostic here since this
// component builds its own independent marker list for the home page.
const missingCoordsRecords = markerResults.filter((m) => m.marker === null).map((m) => m.record);
if (missingCoordsRecords.length > 0) {
  const names = missingCoordsRecords.map((r) => String(r.properties['Name'] ?? r.properties['Title'] ?? r.id)).join(', ');
  console.warn(`[geo] ${missingCoordsRecords.length} record(s) missing coordinates, not shown on map: ${names}`);
}

const hasLookups = Object.keys(lookups).length > 0;
const themeCount = themes.length;
---

<div style="position:relative;width:100%;height:100%;overflow:hidden;">
  <div id="home-map" style="width:100%;height:100%;" data-markers={JSON.stringify(markers)} data-base={base}></div>

  {missingCoordsRecords.length > 0 && (
    <div style="position:absolute;bottom:0.5rem;left:0.5rem;z-index:15;padding:0.35rem 0.6rem;background:rgba(255,255,255,0.92);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--muted);font-size:0.7rem;font-family:var(--mono);text-transform:uppercase;letter-spacing:0.03em;">
      {missingCoordsRecords.length} organization{missingCoordsRecords.length === 1 ? '' : 's'} not shown (missing coordinates)
    </div>
  )}

  <!-- Side panel -->
  <div
    id="home-panel"
    style="position:absolute;top:0.5rem;right:0.5rem;bottom:0.5rem;width:400px;max-width:40%;background:rgba(255,255,255,0.98);backdrop-filter:blur(12px);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;box-shadow:0 8px 32px rgba(42,24,16,0.12);font-family:var(--sans);z-index:20;display:flex;flex-direction:column;"
  >
    <!-- Header -->
    <div style="display:flex;align-items:center;justify-content:space-between;padding:0.875rem 1.25rem;border-bottom:1px solid var(--border);flex-shrink:0;">
      <button id="panel-back-btn" style="display:none;background:none;border:none;color:var(--muted);font-size:0.8rem;cursor:pointer;font-family:var(--mono);text-transform:uppercase;letter-spacing:0.03em;padding:0;" aria-label="Back to welcome">← Back</button>
      <button id="panel-close-btn" style="background:none;border:none;color:var(--muted);font-size:1.1rem;cursor:pointer;line-height:1;padding:0;" aria-label="Close panel">✕</button>
    </div>

    <!-- Scrollable content -->
    <div id="panel-content" style="padding:1.25rem;overflow-y:auto;flex:1;">

      <!-- Welcome view -->
      <div id="panel-welcome">
        <h1 style="font-size:clamp(1.5rem, 2.5vw, 2rem);font-weight:500;margin:0 0 0.6rem 0;color:var(--fg);letter-spacing:-0.01em;line-height:1.2;">Welcome to the Bioregional Knowledge Commons</h1>
        <p style="color:var(--muted);margin:0 0 0.75rem 0;font-size:0.9rem;line-height:1.55;">This is a public knowledge base documenting organizations and practices at the frontier of bioregional work — exploring how communities around the world are learning to live and govern within the logic of place.</p>
        <p style="color:var(--muted);margin:0 0 0.75rem 0;font-size:0.75rem;font-family:var(--mono);text-transform:uppercase;letter-spacing:0.04em;">
          <strong style="color:var(--fg);">{orgCount}</strong> bioregional actors and initiatives currently mapped{themeCount > 0 && <> across <strong style="color:var(--fg);">{themeCount}</strong> themes:</>}
        </p>
        {themeCount > 0 && (
          <div style="display:flex;flex-wrap:wrap;gap:0.4rem;margin-bottom:1rem;">
            {themes.map((theme) => (
              <Badge shape="square" size="sm" icon={theme.icon} data-theme-filter={String(theme.properties['Name'] ?? theme.properties['Title'] ?? '').replace(/_/g, ' ')} class="theme-filter-badge">
                {String(theme.properties['Name'] ?? theme.properties['Title'] ?? '').replace(/_/g, ' ')}
              </Badge>
            ))}
          </div>
        )}

      </div>

      <!-- Detail view -->
      <div id="panel-detail" style="display:none;"></div>

    </div>
  </div>
</div>

<style is:global>
  .maplibregl-popup {
    z-index: 30 !important;
  }
  .map-pin-popup .maplibregl-popup-content {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 4px 16px rgba(42,24,16,0.12);
    padding: 0;
    overflow: hidden;
  }
  .map-pin-popup .maplibregl-popup-tip {
    border-top-color: var(--card);
    border-bottom-color: var(--card);
  }
  .theme-filter-badge { cursor: pointer; }
  .theme-filter-badge:hover { filter: brightness(0.95); }
</style>

{hasLookups && (
  <div style="display:none;">
    {records.map((r) => {
      const slug = r.id.replace(/-/g, '');
      const pathPrefix = r.sectionRoute ? r.sectionRoute.replace(/\/$/, '') : basePath.replace(/\/$/, '');
      const fullPageHref = `${base}${pathPrefix}/${slug}`;
      return (
        <div id={`home-detail-${r.id}`} class="home-detail-template">
          <OrgDetail record={r} lookups={lookups} mode="panel" fullPageHref={fullPageHref} />
        </div>
      );
    })}
  </div>
)}

<script>
  import maplibregl from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';

  function initMap() {
    const container = document.getElementById('home-map');
    if (!container) return;

    const hasLookups = document.querySelector('.home-detail-template') !== null;

    const markers = JSON.parse(container.dataset.markers || '[]');
    const base = container.dataset.base || '';

    if (markers.length === 0) {
      container.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--muted);font-size:0.9rem;font-family:var(--mono);">No geolocated records to display.</div>';
      return;
    }

    const avgLat = markers.reduce((s, m) => s + m.lat, 0) / markers.length;
    const avgLng = markers.reduce((s, m) => s + m.lng, 0) / markers.length;

    const map = new maplibregl.Map({
      container,
      style: {
        version: 8,
        sources: {
          osm: {
            type: 'raster',
            tiles: ['https://tile.openstreetmap.org/{z}/{x}/{y}.png'],
            tileSize: 256,
            attribution: '&copy; OpenStreetMap contributors',
          },
        },
        layers: [{ id: 'osm', type: 'raster', source: 'osm' }],
      },
      center: [avgLng || 0, avgLat || 20],
      zoom: markers.length === 1 ? 4 : 2,
    });

    map.addControl(new maplibregl.NavigationControl(), 'top-left');
    map.addControl(new maplibregl.FullscreenControl(), 'top-left');
    window.addEventListener('view-changed', (e) => {
      if (e.detail?.view === 'map') {
        setTimeout(() => map.resize(), 0);
      }
    });

    const bounds = new maplibregl.LngLatBounds();

    const welcomeDiv = document.getElementById('panel-welcome');
    const detailDiv = document.getElementById('panel-detail');
    const backBtn = document.getElementById('panel-back-btn');
    const closeBtn = document.getElementById('panel-close-btn');
    const contentDiv = document.getElementById('panel-content');
    const panel = document.getElementById('home-panel');
    let panelOpen = true;

    function showWelcome() {
      detailDiv.style.display = 'none';
      welcomeDiv.style.display = 'block';
      backBtn.style.display = 'none';
      if (contentDiv) contentDiv.scrollTop = 0;
    }

    function showDetail(m) {
      openPanel();
      welcomeDiv.style.display = 'none';
      backBtn.style.display = 'inline-block';

      if (hasLookups) {
        const template = document.getElementById(`home-detail-${m.id}`);
        if (template) {
          detailDiv.innerHTML = template.innerHTML;
        } else {
          detailDiv.innerHTML = '<p style="color:var(--muted);">Detail not available.</p>';
        }
      } else {
        detailDiv.innerHTML = `
          <h2 style="font-size:clamp(1.3rem, 2.5vw, 1.6rem);font-weight:500;margin:0 0 0.6rem 0;color:var(--fg);line-height:1.2;letter-spacing:-0.01em;">${m.name}</h2>
          <div style="display:flex;gap:0.6rem;flex-wrap:wrap;">
            <a href="${m.href}" target="_blank" rel="noopener noreferrer" style="display:inline-block;padding:0.5rem 0.9rem;border-radius:var(--radius);background:var(--primary);color:var(--primary-fg);font-size:0.75rem;text-decoration:none;font-family:var(--mono);text-transform:uppercase;letter-spacing:0.03em;">View full page →</a>
          </div>
        `;
      }
      detailDiv.style.display = 'block';
      if (contentDiv) contentDiv.scrollTop = 0;
    }

    // Work Item F2: exposes this map's showDetail so gallery cards (OrganizationsGallery.astro,
    // rendered elsewhere in the same DOM on the home page) can open the same sidebar on click
    // instead of navigating away.
    window.__beShowDetail = (id) => {
      const m = markers.find((x) => x.id === id);
      if (m) showDetail(m);
    };

    backBtn?.addEventListener('click', showWelcome);
    closeBtn?.addEventListener('click', () => {
      panel.style.display = 'none';
      panelOpen = false;
    });
    panel?.addEventListener('click', (e) => e.stopPropagation());

    function openPanel() {
      panel.style.display = 'flex';
      panelOpen = true;
    }

    function placeMarkers() {
      for (const m of markers) {
        const pinColor = m.caseStudy === 'Y' ? '#F0A030' : '#B0A090';
        const marker = new maplibregl.Marker({ color: pinColor, scale: 0.8 })
          .setLngLat([m.lng, m.lat])
          .addTo(map);

        const popup = new maplibregl.Popup({
          offset: 18,
          closeButton: false,
          closeOnClick: false,
          className: 'map-pin-popup',
          anchor: 'bottom',
        }).setHTML(`
          <div style="padding:0.5rem 0.65rem;font-family:var(--sans);max-width:240px;">
            <div style="font-weight:600;font-size:1rem;color:var(--fg);margin-bottom:0.35rem;line-height:1.3;">${m.name}</div>
            ${m.category || (m.tags && m.tags.length) ? `<div style="display:flex;flex-wrap:wrap;gap:0.3rem;margin-bottom:0.35rem;">
              ${m.category ? `<span class="badge badge--sm badge--pill badge--${m.categoryTone}">${m.category}</span>` : ''}
              ${(m.tags || []).map((t) => `<span class="badge badge--sm badge--square badge--neutral">${t.icon ? t.icon + ' ' : ''}${t.name}</span>`).join('')}
            </div>` : ''}
            ${m.place ? `<div style="font-size:0.8rem;color:var(--fg);line-height:1.4;">${m.place}</div>` : ''}
          </div>
        `);
        marker.setPopup(popup);

        const markerEl = marker.getElement();
        markerEl.style.cursor = 'pointer';
        markerEl.addEventListener('mouseenter', () => marker.togglePopup());
        markerEl.addEventListener('mouseleave', () => marker.togglePopup());

        markerEl.addEventListener('click', (e) => {
          e.stopPropagation();
          showDetail(m);
        });

        bounds.extend([m.lng, m.lat]);
      }

      if (markers.length > 1) {
        map.fitBounds(bounds, { padding: 40, maxZoom: 8 });
      }

      map.on('click', showWelcome);
    }

    if (map.loaded()) {
      placeMarkers();
    } else {
      map.on('load', placeMarkers);
    }

    // Ensure the map renders at the correct size after the container is laid out
    requestAnimationFrame(() => map.resize());
  }

  if (document.readyState === 'complete') {
    initMap();
  } else {
    window.addEventListener('load', initMap);
  }

  // Work Item E: welcome-sidebar theme badges switch to gallery view and pre-filter it by that
  // theme, reusing the gallery's existing tag <select> + applyFilters() rather than inventing a
  // second filtering mechanism. index.astro exposes setView() as window.__beSetView.
  function wireThemeBadges() {
    document.querySelectorAll('.theme-filter-badge').forEach((badge) => {
      badge.addEventListener('click', () => {
        const tag = badge.getAttribute('data-theme-filter');
        if (!tag) return;
        window.__beSetView?.('gallery');
        window.dispatchEvent(new CustomEvent('gallery-filter-tag', { detail: { tag } }));
      });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', wireThemeBadges);
  } else {
    wireThemeBadges();
  }
</script>

---
import type { NormalizedRecord } from '../lib/notion';
import { getTitle, getDescription } from '../lib/notion';

function getSourceIcon(src: NormalizedRecord) {
  const type = String(src.properties['Source type'] ?? src.properties['source type'] ?? '').toLowerCase();
  if (type.includes('book')) return '📚';
  if (type.includes('article')) return '📄';
  if (type.includes('report')) return '📊';
  if (type.includes('video')) return '🎬';
  return src.icon ?? '📄';
}

export interface Props {
  record: NormalizedRecord;
  base?: string;
  children?: NormalizedRecord[];
  pageContent?: string;
  lookups?: {
    tags?: Map<string, NormalizedRecord>;
    activities?: Map<string, NormalizedRecord>;
    organizations?: Map<string, NormalizedRecord>;
    sources?: Map<string, NormalizedRecord>;
    affiliations?: Map<string, NormalizedRecord>;
  };
  mode?: 'panel' | 'page';
  fullPageHref?: string;
}
const { record, base = '', children = [], pageContent = '', lookups = {}, mode = 'page', fullPageHref } = Astro.props;

const isPanel = mode === 'panel';
const title = getTitle(record);
const description = getDescription(record);

function slugFor(id: string): string {
  return id.replace(/-/g, '');
}

function hasRelationTo(recordIds: string[], targetId: string): boolean {
  return recordIds.includes(targetId);
}

// Resolve reverse relations: find records whose Tags/Activities/etc point to this ontology item.
const allActivities = Array.from(lookups.activities?.values() ?? []);
const allOrganizations = Array.from(lookups.organizations?.values() ?? []);
const allSources = Array.from(lookups.sources?.values() ?? []);

const relatedActivities = allActivities.filter((r) => {
  const tags: string[] = Array.isArray(r.properties['Tags']) ? r.properties['Tags'] : [];
  return tags.includes(record.id);
});

const relatedOrganizations = allOrganizations.filter((r) => {
  const tags: string[] = Array.isArray(r.properties['Tags']) ? r.properties['Tags'] : [];
  return tags.includes(record.id);
});

const relatedSources = allSources.filter((r) => {
  const tags: string[] = Array.isArray(r.properties['Tags']) ? r.properties['Tags'] : [];
  return tags.includes(record.id);
});

const headingSize = isPanel ? '1.15rem' : '1.25rem';
const sectionHeadingSize = '1.25rem';
---

<div>
  <h2 style={`font-size:clamp(1.2rem, 2.5vw, ${headingSize});font-weight:500;margin:0 0 0.6rem 0;color:var(--fg);line-height:1.2;font-family:var(--sans);letter-spacing:-0.01em;`}>
    {record.icon && <span style="margin-right:0.5rem;">{record.icon}</span>}
    {title}
  </h2>

  {isPanel && fullPageHref && (
    <div style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:1rem;">
      <a href={fullPageHref} style="display:inline-flex;align-items:center;gap:0.4rem;padding:0.5rem 0.9rem;border-radius:var(--radius);background:var(--surface);border:1px solid var(--border);color:var(--fg);font-size:0.75rem;text-decoration:none;font-family:var(--mono);text-transform:uppercase;letter-spacing:0.03em;">
        → View full page
      </a>
    </div>
  )}

  {description && (
    <p style="font-size:0.95rem;color:var(--fg);line-height:1.6;margin:0 0 1.5rem 0;">{description}</p>
  )}

  {children.length > 0 && (
    <div style="margin-bottom:1.5rem;">
      <h3 style={`font-size:${sectionHeadingSize};font-weight:500;margin:0 0 0.75rem 0;color:var(--fg);font-family:var(--sans);letter-spacing:-0.01em;`}>Ontology</h3>
      <div style="display:flex;flex-direction:column;gap:0.75rem;">
        {children.map((child) => (
          <div style="padding:0.85rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
            <div style="display:flex;align-items:center;gap:0.6rem;margin-bottom:0.25rem;">
              <span style="font-size:1.2rem;line-height:1;flex-shrink:0;">{child.icon || '•'}</span>
              <h4 style="margin:0;font-size:0.95rem;font-weight:600;font-family:var(--sans);line-height:1.3;word-break:break-word;overflow-wrap:anywhere;color:var(--fg);">{getTitle(child)}</h4>
            </div>
            {child.properties['Description'] && (
              <p style="margin:0.25rem 0 0 0;font-size:0.85rem;color:var(--muted);line-height:1.5;">{String(child.properties['Description'])}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  )}

  {relatedActivities.length > 0 && (
    <div style="margin-bottom:1.5rem;">
      <h3 style={`font-size:${sectionHeadingSize};font-weight:500;margin:0 0 0.75rem 0;color:var(--fg);font-family:var(--sans);letter-spacing:-0.01em;`}>Activities</h3>
      <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(260px, 1fr));gap:0.75rem;">
        {relatedActivities.map((act) => (
          <div style="padding:1rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
            <div style="display:flex;align-items:center;gap:0.6rem;margin-bottom:0.4rem;">
              <span style="font-size:1.2rem;line-height:1;flex-shrink:0;">{act.icon || '🔸'}</span>
              <h4 style="margin:0;font-size:0.95rem;font-weight:600;font-family:var(--sans);line-height:1.3;word-break:break-word;overflow-wrap:anywhere;color:var(--fg);">{getTitle(act)}</h4>
            </div>
            {act.properties['Description'] && (
              <p style="margin:0;font-size:0.85rem;color:var(--muted);line-height:1.55;">{String(act.properties['Description'])}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  )}

  {relatedOrganizations.length > 0 && (
    <div style="margin-bottom:1.5rem;">
      <h3 style={`font-size:${sectionHeadingSize};font-weight:500;margin:0 0 0.75rem 0;color:var(--fg);font-family:var(--sans);letter-spacing:-0.01em;`}>Organizations</h3>
      <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
        {relatedOrganizations.map((org) => (
          <a href={`${base}/organizations/${slugFor(org.id)}`} style="display:inline-flex;align-items:center;gap:0.4rem;padding:0.45rem 0.75rem;border-radius:var(--radius);background:var(--surface);border:1px solid var(--border);color:var(--fg);text-decoration:none;font-size:0.85rem;">
            <span>{org.icon || '🌱'}</span>
            <span style="word-break:break-word;overflow-wrap:anywhere;">{getTitle(org)}</span>
          </a>
        ))}
      </div>
    </div>
  )}

  {relatedSources.length > 0 && (
    <div style="margin-bottom:1.5rem;">
      <h3 style={`font-size:${sectionHeadingSize};font-weight:500;margin:0 0 0.75rem 0;color:var(--fg);font-family:var(--sans);letter-spacing:-0.01em;`}>Sources</h3>
      <div style="overflow-x:auto;border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
        <table style="width:100%;border-collapse:collapse;font-size:0.9rem;">
          <thead>
            <tr style="border-bottom:1px solid var(--border);background:var(--surface);">
              <th style="text-align:left;padding:0.6rem 1rem;font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);font-weight:500;">Type</th>
              <th style="text-align:left;padding:0.6rem 1rem;font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);font-weight:500;">Name</th>
              <th style="text-align:left;padding:0.6rem 1rem;font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);font-weight:500;white-space:nowrap;">Full record</th>
            </tr>
          </thead>
          <tbody>
            {relatedSources.map((src) => {
              const sourceType = String(src.properties['Source type'] ?? src.properties['source type'] ?? '');
              return (
                <tr style="border-bottom:1px solid var(--border);">
                  <td style="padding:0.5rem 1rem;color:var(--muted);white-space:nowrap;">
                    <span style="margin-right:0.35rem;">{getSourceIcon(src)}</span>
                    <span style="font-size:0.8rem;font-family:var(--mono);text-transform:uppercase;letter-spacing:0.02em;">{sourceType}</span>
                  </td>
                  <td style="padding:0.5rem 1rem;color:var(--fg);font-weight:500;">{getTitle(src)}</td>
                  <td style="padding:0.5rem 1rem;">
                    <a href={`${base}/sources/${slugFor(src.id)}`} style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:var(--radius);background:var(--surface);color:var(--primary);font-size:0.9rem;text-decoration:none;" aria-label="Open full record">
                      ↗
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  )}

  {pageContent && (
    <div style="margin-bottom:1.5rem;" set:html={pageContent} />
  )}
</div>

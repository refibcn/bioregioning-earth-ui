---
import type { NormalizedRecord } from '../lib/notion';
import { getTitle, getDescription, humanize } from '../lib/notion';
import Badge from './Badge.astro';

export interface Props {
  record: NormalizedRecord;
  base?: string;
  children?: NormalizedRecord[];
  pageContent?: { intro: string; ontology: string; activities: string };
  lookups?: {
    tags?: Map<string, NormalizedRecord>;
    activities?: Map<string, NormalizedRecord>;
    organizations?: Map<string, NormalizedRecord>;
    sources?: Map<string, NormalizedRecord>;
    affiliations?: Map<string, NormalizedRecord>;
  };
  mode?: 'panel' | 'page';
  fullPageHref?: string;
}
const EMPTY_PAGE_CONTENT = { intro: '', ontology: '', activities: '' };
const { record, children = [], pageContent = EMPTY_PAGE_CONTENT, lookups = {}, mode = 'page' } = Astro.props;

const isPanel = mode === 'panel';
const title = humanize(getTitle(record));

// Heading size is now the same in both modes (was 1.15rem panel / 1.6rem page) — the
// inconsistency was the actual complaint, not the panel needing to be smaller.
const headingSize = '1.4rem';
const sectionHeadingSize = '1.25rem';

// Activities related to this theme: matched against an activity's Tags relation (named
// "Ontology" on the live schema) including this record's own id and all of its children's —
// so a parent theme picks up activities tagged with any of its child tags, not just itself.
const allActivities = Array.from(lookups.activities?.values() ?? []);
const childIds = children.map((c) => c.id);
const activityTargetIds = new Set([record.id, ...childIds]);

function getActTagIds(act: NormalizedRecord): string[] {
  return Array.isArray(act.properties['Ontology']) ? act.properties['Ontology'] : [];
}
function getActOrgIds(act: NormalizedRecord): string[] {
  return Array.isArray(act.properties['Organization']) ? act.properties['Organization'] : [];
}

const relatedActivities = allActivities.filter((act) => getActTagIds(act).some((id) => activityTargetIds.has(id)));

const activityRows = relatedActivities.map((act) => {
  const tags = getActTagIds(act).map((id) => lookups.tags?.get(id)).filter(Boolean) as NormalizedRecord[];
  const orgs = getActOrgIds(act).map((id) => lookups.organizations?.get(id)).filter(Boolean) as NormalizedRecord[];
  return {
    record: act,
    title: getTitle(act),
    description: String(act.properties['Description'] ?? act.properties['description'] ?? ''),
    tags,
    orgs,
  };
});

// Filter option lists — only tags/orgs actually present among this theme's related activities,
// not every tag/org site-wide.
const tagFilterOptions = Array.from(
  new Map(activityRows.flatMap((a) => a.tags).map((t) => [t.id, t])).values()
).sort((a, b) => humanize(getTitle(a)).localeCompare(humanize(getTitle(b))));
const orgFilterOptions = Array.from(
  new Map(activityRows.flatMap((a) => a.orgs).map((o) => [o.id, o])).values()
).sort((a, b) => getTitle(a).localeCompare(getTitle(b)));
---

<div class="ontology-detail-root">
  <h2 style={`font-size:clamp(1.15rem, 2.5vw, ${headingSize});font-weight:500;margin:0 0 0.6rem 0;color:var(--fg);line-height:1.2;font-family:var(--sans);letter-spacing:-0.01em;`}>
    {record.icon && <span style="margin-right:0.5rem;">{record.icon}</span>}
    {title}
  </h2>

  <!-- Title + long description (pageContent.intro, everything in the Notion page body before
       either heading below) is the whole "header" — nothing else goes above the two
       subheadings. -->
  {pageContent.intro && (
    <div style="margin-bottom:1.5rem;" set:html={pageContent.intro} />
  )}

  {children.length > 0 && (
    <div style="margin-bottom:1.5rem;">
      <!-- Prefer the Notion-authored "Ontology" heading (pageContent.ontology) as this section's
           header when the page body has one — it's often followed by an inline database embed
           our block renderer can't turn into HTML, so this fills that gap with the live tag
           cards below instead of the app inventing a second, redundant heading. -->
      {pageContent.ontology ? (
        <div set:html={pageContent.ontology} />
      ) : (
        <h3 style={`font-size:${sectionHeadingSize};font-weight:500;margin:1.75rem 0 0.75rem 0;color:var(--fg);font-family:var(--sans);letter-spacing:-0.01em;`}>Tag Ontology</h3>
      )}
      <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(240px, 1fr));gap:0.75rem;">
        {children.map((child) => (
          <div style="padding:1rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
            <h4 style="margin:0 0 0.4rem 0;font-size:0.95rem;font-weight:500;font-family:var(--sans);line-height:1.3;word-break:break-word;overflow-wrap:anywhere;color:var(--fg);">
              {child.icon && <span style="margin-right:0.4rem;">{child.icon}</span>}
              {humanize(getTitle(child))}
            </h4>
            {getDescription(child) && (
              <p style="margin:0;font-size:0.85rem;color:var(--muted);line-height:1.55;">{getDescription(child)}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  )}

  {activityRows.length > 0 && (
    <div style="margin-bottom:1.5rem;">
      <!-- Same pattern as the Ontology section above: prefer the Notion-authored "Activities"
           heading, filling its embed gap with the live filters + activity feed below. -->
      {pageContent.activities ? (
        <div set:html={pageContent.activities} />
      ) : (
        <h3 style={`font-size:${sectionHeadingSize};font-weight:500;margin:1.75rem 0 0.75rem 0;color:var(--fg);font-family:var(--sans);letter-spacing:-0.01em;`}>Activities</h3>
      )}

      {(tagFilterOptions.length > 0 || orgFilterOptions.length > 0) && (
        <div style="display:flex;flex-wrap:wrap;gap:0.75rem;margin-bottom:1rem;">
          {tagFilterOptions.length > 0 && (
            <div class="ontology-filter-wrap" style="position:relative;">
              <button type="button" class="ontology-tags-filter-toggle field-control" style="cursor:pointer;white-space:nowrap;">
                Tags<span class="ontology-tags-filter-count"></span>
              </button>
              <div class="ontology-tags-filter-dropdown filter-dropdown">
                {tagFilterOptions.map((t) => (
                  <label class="filter-dropdown-option">
                    <input type="checkbox" class="ontology-tags-filter-checkbox" value={t.id} />
                    {t.icon ? `${t.icon} ` : ''}{humanize(getTitle(t))}
                  </label>
                ))}
              </div>
            </div>
          )}
          {orgFilterOptions.length > 0 && (
            <div class="ontology-filter-wrap" style="position:relative;">
              <button type="button" class="ontology-org-filter-toggle field-control" style="cursor:pointer;white-space:nowrap;">
                Organizations<span class="ontology-org-filter-count"></span>
              </button>
              <div class="ontology-org-filter-dropdown filter-dropdown">
                {orgFilterOptions.map((o) => (
                  <label class="filter-dropdown-option">
                    <input type="checkbox" class="ontology-org-filter-checkbox" value={o.id} />
                    {getTitle(o)}
                  </label>
                ))}
              </div>
            </div>
          )}
        </div>
      )}

      <div class="ontology-activities-grid" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(260px, 1fr));gap:0.75rem;">
        {activityRows.map((a) => (
          <div
            class="ontology-activity-card"
            data-tags={a.tags.map((t) => t.id).join('|')}
            data-orgs={a.orgs.map((o) => o.id).join('|')}
            style="padding:1rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--card);"
          >
            <h4 style="margin:0 0 0.25rem 0;font-size:0.95rem;font-weight:500;font-family:var(--sans);line-height:1.3;word-break:break-word;overflow-wrap:anywhere;color:var(--fg);">{a.title}</h4>
            {a.orgs.length > 0 && (
              <p style="margin:0 0 0.4rem 0;font-size:0.75rem;color:var(--muted);font-family:var(--mono);text-transform:uppercase;letter-spacing:0.03em;">
                {a.orgs.map((o) => getTitle(o)).join(', ')}
              </p>
            )}
            {a.tags.length > 0 && (
              <div style="display:flex;flex-wrap:wrap;gap:0.35rem;margin-bottom:0.5rem;">
                {a.tags.map((tag) => (
                  <Badge size="sm" shape="square" icon={tag.icon}>{humanize(getTitle(tag))}</Badge>
                ))}
              </div>
            )}
            {a.description && (
              <p style="margin:0;font-size:0.85rem;color:var(--muted);line-height:1.55;">{a.description}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  )}
</div>

<script>
  // Activities filters (Tags, Organizations) — multi-select checkboxes, match-any within each
  // filter, AND between the two filters. Event-delegated on document (not per-element
  // addEventListener) because OntologyGallery.astro's side panel injects a clone of this
  // component's markup into the DOM well after this script's module has already run once at
  // page load. Scoped to the interacted element's own .ontology-detail-root so multiple hidden
  // panel templates on the same listing page (one per parent theme) don't cross-filter.
  function applyOntologyActivityFilters(root: Element) {
    const grid = root.querySelector('.ontology-activities-grid');
    if (!grid) return;
    const selectedTags = Array.from(root.querySelectorAll('.ontology-tags-filter-checkbox'))
      .filter((cb) => (cb as HTMLInputElement).checked)
      .map((cb) => (cb as HTMLInputElement).value);
    const selectedOrgs = Array.from(root.querySelectorAll('.ontology-org-filter-checkbox'))
      .filter((cb) => (cb as HTMLInputElement).checked)
      .map((cb) => (cb as HTMLInputElement).value);
    const tagsCountEl = root.querySelector('.ontology-tags-filter-count');
    const orgCountEl = root.querySelector('.ontology-org-filter-count');
    if (tagsCountEl) tagsCountEl.textContent = selectedTags.length > 0 ? ` (${selectedTags.length})` : '';
    if (orgCountEl) orgCountEl.textContent = selectedOrgs.length > 0 ? ` (${selectedOrgs.length})` : '';

    grid.querySelectorAll('.ontology-activity-card').forEach((card) => {
      const cardTags = (card.getAttribute('data-tags') ?? '').split('|').filter(Boolean);
      const cardOrgs = (card.getAttribute('data-orgs') ?? '').split('|').filter(Boolean);
      const matchesTags = selectedTags.length === 0 || selectedTags.some((t) => cardTags.includes(t));
      const matchesOrgs = selectedOrgs.length === 0 || selectedOrgs.some((o) => cardOrgs.includes(o));
      (card as HTMLElement).style.display = matchesTags && matchesOrgs ? '' : 'none';
    });
  }

  document.addEventListener('change', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target?.matches?.('.ontology-tags-filter-checkbox, .ontology-org-filter-checkbox')) return;
    const root = target.closest('.ontology-detail-root');
    if (root) applyOntologyActivityFilters(root);
  });

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    const toggle = target?.closest?.('.ontology-tags-filter-toggle, .ontology-org-filter-toggle') as HTMLElement | null;
    if (toggle) {
      e.stopPropagation();
      const wrap = toggle.closest('.ontology-filter-wrap');
      const dropdown = wrap?.querySelector('.filter-dropdown') as HTMLElement | null;
      if (dropdown) dropdown.style.display = dropdown.style.display === 'none' ? 'block' : 'none';
      return;
    }
    // Click outside any open dropdown closes it.
    document.querySelectorAll('.ontology-filter-wrap .filter-dropdown').forEach((dd) => {
      if (!dd.contains(target) ) (dd as HTMLElement).style.display = 'none';
    });
  });
</script>

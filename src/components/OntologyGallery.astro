---
import type { NormalizedRecord } from '../lib/notion';
import { humanize } from '../lib/notion';
import { splitParentsAndChildren } from '../lib/ontology';
import OntologyDetail from './OntologyDetail.astro';
import Badge from './Badge.astro';

export interface Props {
  records: NormalizedRecord[];
  basePath?: string;
  lookups?: {
    activities?: Map<string, NormalizedRecord>;
    organizations?: Map<string, NormalizedRecord>;
    sources?: Map<string, NormalizedRecord>;
  };
  pageContents?: Record<string, { intro: string; ontology: string; activities: string }>;
}
const { records, basePath = '/', lookups = {}, pageContents = {} } = Astro.props;
const EMPTY_ONTOLOGY_CONTENT = { intro: '', ontology: '', activities: '' };
const base = import.meta.env.BASE_URL;

function getTitle(r: NormalizedRecord): string {
  return String(r.properties['Name'] ?? r.properties['Title'] ?? r.properties['name'] ?? r.properties['title'] ?? 'Untitled');
}

function getDescription(r: NormalizedRecord): string {
  return String(r.properties['Description'] ?? r.properties['description'] ?? '');
}

function getIcon(r: NormalizedRecord): string {
  return r.icon ?? '•';
}

const { parents, childrenByParent } = splitParentsAndChildren(records);

const hasLookups = Object.keys(lookups).length > 0;

function resolveChildren(parentId: string): NormalizedRecord[] {
  return childrenByParent[parentId] ?? [];
}

function resolveActivities(record: NormalizedRecord): NormalizedRecord[] {
  const ids: string[] = Array.isArray(record.properties['Activities']) ? record.properties['Activities'] : [];
  return ids.map((id) => lookups.activities?.get(id)).filter(Boolean) as NormalizedRecord[];
}

function resolveOrganizations(record: NormalizedRecord): NormalizedRecord[] {
  const ids: string[] = Array.isArray(record.properties['Organizations']) ? record.properties['Organizations'] : [];
  return ids.map((id) => lookups.organizations?.get(id)).filter(Boolean) as NormalizedRecord[];
}

function resolveSources(record: NormalizedRecord): NormalizedRecord[] {
  const ids: string[] = Array.isArray(record.properties['Sources']) ? record.properties['Sources'] : [];
  return ids.map((id) => lookups.sources?.get(id)).filter(Boolean) as NormalizedRecord[];
}
---

<div id="ontology-gallery-root" style="position:relative;">
  <div style="display:grid;grid-template-columns:repeat(3, 1fr);gap:1.5rem;">
    {parents.map((parent) => {
      const slug = parent.id.replace(/-/g, '');
      const href = `${base}${basePath.replace(/\/$/, '')}/${slug}`;
      const children = resolveChildren(parent.id);

      return (
        <section
          class="ontology-parent-card"
          data-id={parent.id}
          data-full-href={href}
          style="display:flex;flex-direction:column;gap:0.6rem;padding:1.25rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--card);cursor:pointer;"
        >
          <div style="display:flex;align-items:center;gap:0.75rem;">
            <span style="font-size:1.6rem;line-height:1;flex-shrink:0;">{getIcon(parent)}</span>
            <h2 style="margin:0;font-size:1.25rem;font-weight:500;font-family:var(--sans);letter-spacing:-0.01em;word-break:break-word;overflow-wrap:anywhere;">{humanize(getTitle(parent))}</h2>
          </div>
          {getDescription(parent) && (
            <p style="margin:0;color:var(--muted);font-size:0.9rem;line-height:1.5;">{getDescription(parent)}</p>
          )}
          {children.length > 0 && (
            <div style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-top:0.4rem;">
              {children.map((child) => (
                <Badge shape="square" icon={getIcon(child)}>{humanize(getTitle(child))}</Badge>
              ))}
            </div>
          )}
        </section>
      );
    })}
  </div>

  {/* Hidden detail templates */}
  {hasLookups && (
    <div id="ontology-detail-templates" style="display:none;">
      {parents.map((parent) => {
        const slug = parent.id.replace(/-/g, '');
        const href = `${base}${basePath.replace(/\/$/, '')}/${slug}`;
        return (
          <div id={`ontology-detail-${parent.id}`} class="ontology-detail-template">
            <OntologyDetail
              record={parent}
              base={base}
              children={resolveChildren(parent.id)}
              pageContent={pageContents[parent.id] ?? EMPTY_ONTOLOGY_CONTENT}
              lookups={lookups}
              mode="panel"
              fullPageHref={href}
            />
          </div>
        );
      })}
    </div>
  )}

  <!-- Side panel -->
  <div
    id="ontology-side-panel"
    style="display:none;position:fixed;top:0;right:0;bottom:0;width:460px;max-width:45%;background:color-mix(in srgb, var(--paper-50) 98%, transparent);backdrop-filter:blur(12px);border-left:1px solid var(--border);overflow:hidden;box-shadow:-8px 0 32px rgba(42,24,16,0.12);font-family:var(--sans);z-index:100;flex-direction:column;"
  >
    <div style="display:flex;align-items:center;justify-content:space-between;padding:0.875rem 1.25rem;border-bottom:1px solid var(--border);flex-shrink:0;">
      <a id="ontology-panel-viewfull" href="#" style="color:var(--muted);font-size:0.75rem;font-family:var(--mono);text-transform:uppercase;letter-spacing:0.03em;text-decoration:none;" aria-label="View full page">→ View full page</a>
      <button id="ontology-panel-close" style="background:none;border:none;color:var(--muted);font-size:1.1rem;cursor:pointer;line-height:1;padding:0;" aria-label="Close panel">✕</button>
    </div>
    <div id="ontology-panel-content" style="padding:1.25rem;overflow-y:auto;flex:1;"></div>
  </div>
</div>

<script define:vars={{ hasLookups }}>
  (function () {
    if (!hasLookups) return;

    const panel = document.getElementById('ontology-side-panel');
    const panelContent = document.getElementById('ontology-panel-content');
    const panelClose = document.getElementById('ontology-panel-close');
    const panelViewFull = document.getElementById('ontology-panel-viewfull');

    function openPanel(id) {
      if (!panel || !panelContent) return;
      const template = document.getElementById(`ontology-detail-${id}`);
      if (!template) return;
      panelContent.innerHTML = template.innerHTML;
      const card = document.querySelector(`.ontology-parent-card[data-id="${id}"]`);
      const fullHref = card?.getAttribute('data-full-href');
      if (panelViewFull && fullHref) panelViewFull.setAttribute('href', fullHref);
      panel.style.display = 'flex';
      panelContent.scrollTop = 0;
    }

    function closePanel() {
      if (panel) panel.style.display = 'none';
    }

    panelClose?.addEventListener('click', closePanel);

    document.querySelectorAll('.ontology-parent-card').forEach((card) => {
      card.addEventListener('click', () => {
        const id = card.getAttribute('data-id');
        if (id) openPanel(id);
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closePanel();
    });
  })();
</script>

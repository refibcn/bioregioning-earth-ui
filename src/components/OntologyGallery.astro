---
import type { NormalizedRecord } from '../lib/notion';
import { humanize } from '../lib/notion';
import OntologyDetail from './OntologyDetail.astro';
import Badge from './Badge.astro';

export interface Props {
  records: NormalizedRecord[];
  basePath?: string;
  lookups?: {
    activities?: Map<string, NormalizedRecord>;
    organizations?: Map<string, NormalizedRecord>;
    sources?: Map<string, NormalizedRecord>;
  };
  pageContents?: Record<string, string>;
}
const { records, basePath = '/', lookups = {}, pageContents = {} } = Astro.props;
const base = import.meta.env.BASE_URL;

function getTitle(r: NormalizedRecord): string {
  return String(r.properties['Name'] ?? r.properties['Title'] ?? r.properties['name'] ?? r.properties['title'] ?? 'Untitled');
}

function getDescription(r: NormalizedRecord): string {
  return String(r.properties['Description'] ?? r.properties['description'] ?? '');
}

function getIcon(r: NormalizedRecord): string {
  return r.icon ?? '•';
}

function getSortOrder(r: NormalizedRecord): number {
  const raw = r.properties['Sort order'] ?? r.properties['sort order'] ?? r.properties['Sort Order'] ?? r.properties['sort_order'];
  const num = typeof raw === 'number' ? raw : Number(raw);
  return isNaN(num) ? Infinity : num;
}

// Detect a self-referential relation property that links ontology items to parents.
function findParentRelationKey(items: NormalizedRecord[]): string | null {
  const itemIds = new Set(items.map((r) => r.id));
  const candidateScores: Record<string, number> = {};

  for (const r of items) {
    for (const [key, value] of Object.entries(r.properties)) {
      if (Array.isArray(value) && value.length > 0 && value.every((v) => typeof v === 'string' && v.replace(/-/g, '').length === 32)) {
        if (value.some((v) => itemIds.has(v))) {
          candidateScores[key] = (candidateScores[key] ?? 0) + 1;
        }
      }
    }
  }

  const sorted = Object.entries(candidateScores).sort((a, b) => b[1] - a[1]);
  return sorted[0]?.[0] ?? null;
}

const parentKey = findParentRelationKey(records);

const parents: NormalizedRecord[] = [];
const childrenByParent: Record<string, NormalizedRecord[]> = {};

for (const r of records) {
  const rawParent = parentKey ? r.properties[parentKey] : null;
  const parentId = Array.isArray(rawParent) ? rawParent[0] : rawParent;

  if (!parentId) {
    parents.push(r);
  } else {
    if (!childrenByParent[parentId]) childrenByParent[parentId] = [];
    childrenByParent[parentId].push(r);
  }
}

// Sort by Sort order property, then alphabetically.
parents.sort((a, b) => {
  const orderDiff = getSortOrder(a) - getSortOrder(b);
  return orderDiff !== 0 ? orderDiff : getTitle(a).localeCompare(getTitle(b));
});
for (const pid of Object.keys(childrenByParent)) {
  childrenByParent[pid].sort((a, b) => {
    const orderDiff = getSortOrder(a) - getSortOrder(b);
    return orderDiff !== 0 ? orderDiff : getTitle(a).localeCompare(getTitle(b));
  });
}

const hasLookups = Object.keys(lookups).length > 0;

function resolveChildren(parentId: string): NormalizedRecord[] {
  return childrenByParent[parentId] ?? [];
}

function resolveActivities(record: NormalizedRecord): NormalizedRecord[] {
  const ids: string[] = Array.isArray(record.properties['Activities']) ? record.properties['Activities'] : [];
  return ids.map((id) => lookups.activities?.get(id)).filter(Boolean) as NormalizedRecord[];
}

function resolveOrganizations(record: NormalizedRecord): NormalizedRecord[] {
  const ids: string[] = Array.isArray(record.properties['Organizations']) ? record.properties['Organizations'] : [];
  return ids.map((id) => lookups.organizations?.get(id)).filter(Boolean) as NormalizedRecord[];
}

function resolveSources(record: NormalizedRecord): NormalizedRecord[] {
  const ids: string[] = Array.isArray(record.properties['Sources']) ? record.properties['Sources'] : [];
  return ids.map((id) => lookups.sources?.get(id)).filter(Boolean) as NormalizedRecord[];
}
---

<div id="ontology-gallery-root" style="position:relative;">
  <div style="display:flex;flex-direction:column;gap:1.5rem;">
    {parents.map((parent) => {
      const slug = parent.id.replace(/-/g, '');
      const href = `${base}${basePath.replace(/\/$/, '')}/${slug}`;
      const children = resolveChildren(parent.id);

      return (
        <section style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);overflow:hidden;">
          <div class="ontology-parent-card" data-id={parent.id} style="padding:1.25rem 1.5rem;background:var(--surface);border-bottom:1px solid var(--border);cursor:pointer;">
            <div style="display:flex;align-items:center;gap:0.75rem;">
              <span style="font-size:1.6rem;line-height:1;flex-shrink:0;">{getIcon(parent)}</span>
              <h2 style="margin:0;font-size:1.25rem;font-weight:600;font-family:var(--sans);letter-spacing:-0.01em;word-break:break-word;overflow-wrap:anywhere;">{humanize(getTitle(parent))}</h2>
            </div>
            {getDescription(parent) && (
              <p style="margin:0.5rem 0 0 0;color:var(--muted);font-size:0.9rem;line-height:1.5;">{getDescription(parent)}</p>
            )}
          </div>

          {children.length > 0 && (
            <div style="padding:1.25rem 1.5rem;">
              <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
                {children.map((child) => (
                  <Badge shape="square" icon={getIcon(child)}>{humanize(getTitle(child))}</Badge>
                ))}
              </div>
            </div>
          )}
        </section>
      );
    })}
  </div>

  {/* Hidden detail templates */}
  {hasLookups && (
    <div id="ontology-detail-templates" style="display:none;">
      {parents.map((parent) => {
        const slug = parent.id.replace(/-/g, '');
        const href = `${base}${basePath.replace(/\/$/, '')}/${slug}`;
        return (
          <div id={`ontology-detail-${parent.id}`} class="ontology-detail-template">
            <OntologyDetail
              record={parent}
              base={base}
              children={resolveChildren(parent.id)}
              pageContent={pageContents[parent.id] ?? ''}
              lookups={lookups}
              mode="panel"
              fullPageHref={href}
            />
          </div>
        );
      })}
    </div>
  )}

  <!-- Side panel -->
  <div
    id="ontology-side-panel"
    style="display:none;position:fixed;top:0;right:0;bottom:0;width:420px;max-width:40%;background:rgba(255,255,255,0.98);backdrop-filter:blur(12px);border-left:1px solid var(--border);overflow:hidden;box-shadow:-8px 0 32px rgba(42,24,16,0.12);font-family:var(--sans);z-index:100;flex-direction:column;"
  >
    <div style="display:flex;align-items:center;justify-content:space-between;padding:0.875rem 1.25rem;border-bottom:1px solid var(--border);flex-shrink:0;">
      <span style="font-size:0.7rem;font-family:var(--mono);text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);">Ontology</span>
      <button id="ontology-panel-close" style="background:none;border:none;color:var(--muted);font-size:1.1rem;cursor:pointer;line-height:1;padding:0;" aria-label="Close panel">✕</button>
    </div>
    <div id="ontology-panel-content" style="padding:1.25rem;overflow-y:auto;flex:1;"></div>
  </div>
</div>

<script define:vars={{ hasLookups }}>
  (function () {
    if (!hasLookups) return;

    const panel = document.getElementById('ontology-side-panel');
    const panelContent = document.getElementById('ontology-panel-content');
    const panelClose = document.getElementById('ontology-panel-close');

    function openPanel(id) {
      if (!panel || !panelContent) return;
      const template = document.getElementById(`ontology-detail-${id}`);
      if (!template) return;
      panelContent.innerHTML = template.innerHTML;
      panel.style.display = 'flex';
      panelContent.scrollTop = 0;
    }

    function closePanel() {
      if (panel) panel.style.display = 'none';
    }

    panelClose?.addEventListener('click', closePanel);

    document.querySelectorAll('.ontology-parent-card').forEach((card) => {
      card.addEventListener('click', () => {
        const id = card.getAttribute('data-id');
        if (id) openPanel(id);
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closePanel();
    });
  })();
</script>

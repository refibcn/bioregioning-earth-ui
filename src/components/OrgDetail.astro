---
import type { NormalizedRecord } from '../lib/notion';
import { getTitle, getDescription, getUrl, getPlace, getCategory, renderMarkdown, humanize, toneForCategory } from '../lib/notion';
import Badge from './Badge.astro';

function getSourceIcon(src) {
  const type = String(src.properties['Source type'] ?? src.properties['source type'] ?? '').toLowerCase();
  if (type.includes('book')) return '📚';
  if (type.includes('article')) return '📄';
  if (type.includes('report')) return '📊';
  if (type.includes('video')) return '🎬';
  return src.icon ?? '📄';
}

export interface Props {
  record: NormalizedRecord;
  base?: string;
  lookups: {
    tags?: Map<string, NormalizedRecord>;
    activities?: Map<string, NormalizedRecord>;
    sources?: Map<string, NormalizedRecord>;
    affiliations?: Map<string, NormalizedRecord>;
  };
  mode?: 'panel' | 'page';
  fullPageHref?: string;
}
const { record, base = '', lookups, mode = 'page', fullPageHref } = Astro.props;

const isPanel = mode === 'panel';
const title = getTitle(record);

function formatPropertyValue(value: any): string {
  if (value === null || value === undefined) return '';
  if (Array.isArray(value)) return value.join(', ');
  if (typeof value === 'object') {
    if ('address' in value && value.address) return String(value.address);
    if ('name' in value && value.name) return String(value.name);
    if ('latitude' in value && 'longitude' in value) return `${value.latitude}, ${value.longitude}`;
    try { return JSON.stringify(value); } catch { return '[Object]'; }
  }
  return String(value);
}

function shouldShowBasicProperty(key: string, value: any): boolean {
  const keyLower = key.toLowerCase();
  const hiddenKeys = [
    'source_file', 'id', 'location_lat', 'location_lng', 'name',
    'tags', 'activities', 'sources', 'network affiliation', 'network_affiliation',
    'background_section', 'vision_legacy_section', 'bioregional_context',
    'description', 'website', 'place', 'category', 'type', 'temp', 'patterns', 'case study', 'links'
  ];
  if (hiddenKeys.includes(keyLower)) return false;
  if (value === null || value === undefined || value === '' || (Array.isArray(value) && value.length === 0)) return false;
  if (typeof value === 'object' && 'latitude' in value && 'longitude' in value && !('address' in value && value.address)) return false;
  return true;
}

const basicProperties = Object.entries(record.properties).filter(([key, value]) => shouldShowBasicProperty(key, value));

const tagIds: string[] = Array.isArray(record.properties['Tags']) ? record.properties['Tags'] : [];
const activityIds: string[] = Array.isArray(record.properties['Activities']) ? record.properties['Activities'] : [];
const sourceIds: string[] = Array.isArray(record.properties['Sources']) ? record.properties['Sources'] : [];

const tags = tagIds.map((id) => lookups.tags?.get(id)).filter(Boolean) as NormalizedRecord[];
const activities = activityIds.map((id) => lookups.activities?.get(id)).filter(Boolean) as NormalizedRecord[];
const sources = sourceIds.map((id) => lookups.sources?.get(id)).filter(Boolean) as NormalizedRecord[];

// Network Affiliation: support both relation IDs and rollup names
const rawAffiliations = record.properties['Network Affiliation'];
const uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const affiliationOrgs: NormalizedRecord[] = [];
const affiliationNames: string[] = [];
if (Array.isArray(rawAffiliations)) {
  for (const val of rawAffiliations) {
    if (typeof val === 'string' && uuidPattern.test(val)) {
      const found = lookups.affiliations?.get(val);
      if (found) affiliationOrgs.push(found);
    } else if (typeof val === 'string' && val.trim()) {
      affiliationNames.push(val.trim());
    } else if (val && typeof val === 'object') {
      const name = val.name ?? val.title ?? val.Name ?? '';
      if (name) affiliationNames.push(String(name).trim());
    }
  }
}

const background = String(record.properties['background_section'] ?? record.properties['Background_section'] ?? '');
const vision = String(record.properties['vision_legacy_section'] ?? record.properties['Vision_legacy_section'] ?? '');
const context = String(record.properties['bioregional_context'] ?? record.properties['Bioregional_context'] ?? '');
const website = getUrl(record);
const place = getPlace(record);
const category = getCategory(record);
const description = getDescription(record);
const isCaseStudy = String(record.properties['Case Study'] ?? record.properties['case study'] ?? '').toUpperCase() === 'Y';

function slugFor(id: string): string {
  return id.replace(/-/g, '');
}

// Heading size is unified across panel/page (matches OntologyDetail.astro's scheme exactly, so
// both entity types' sidebars share one design) and sized to sit clearly above the 1.15rem card
// and map-hover tier — it used to collapse to 1.15rem in panel mode, i.e. exactly the same size
// as the gallery card it was opened from.
const headingSize = '1.4rem';
const sectionHeadingSize = '1.25rem'; // match markdown h2 size from renderMarkdown()
---

<div>
  {(category || isCaseStudy) && (
    <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;margin-bottom:0.5rem;">
      {category ? <Badge size="xs" tone={toneForCategory(category)}>{category}</Badge> : <span />}
      {isCaseStudy && (
        <span style="font-family:var(--mono);font-size:0.65rem;text-transform:uppercase;letter-spacing:0.04em;color:var(--muted);"><span class="case-study-dot"></span>Case study</span>
      )}
    </div>
  )}

  <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:0.75rem;margin-bottom:0.4rem;">
    <h2 style={`font-size:clamp(1.15rem, 2.5vw, ${headingSize});font-weight:500;margin:0;color:var(--fg);line-height:1.2;font-family:var(--sans);letter-spacing:-0.01em;`}>
      {title}
    </h2>
    {website && (
      <a href={website} target="_blank" rel="noopener noreferrer" aria-label="Visit website" style="flex-shrink:0;font-size:1.15em;line-height:1.2;text-decoration:none;">
        🌐
      </a>
    )}
  </div>

  {place && (
    <div style="font-size:0.85rem;color:var(--muted);line-height:1.4;margin-bottom:0.75rem;">📍 {place}</div>
  )}

  {description && (
    <p style="font-size:0.9rem;color:var(--fg);line-height:1.6;margin:0 0 1rem 0;">{description}</p>
  )}

  {context && (
    <div style="margin-bottom:1rem;">
      <p style="font-size:0.7rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.04em;font-family:var(--mono);margin:0 0 0.25rem 0;">Bioregional Context</p>
      <p style="font-size:0.9rem;color:var(--fg);line-height:1.55;margin:0;">{context}</p>
    </div>
  )}

  <dl style={`display:grid;grid-template-columns:1fr;gap:${isPanel ? '0.75rem' : '1rem'};margin:0 0 1.5rem 0;`}>
    {basicProperties.map(([key, value]) => (
      <div style={`display:grid;grid-template-columns:${isPanel ? '100px' : '140px'} 1fr;gap:0.5rem;align-items:start;`}>
        <dt style="font-size:0.7rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em;padding-top:0.15rem;font-family:var(--mono);">{key}</dt>
        <dd style="margin:0;font-size:0.9rem;color:var(--fg);word-break:break-word;">{formatPropertyValue(value)}</dd>
      </div>
    ))}
    {(affiliationOrgs.length > 0 || affiliationNames.length > 0) && (
      <div style={`display:grid;grid-template-columns:${isPanel ? '100px' : '140px'} 1fr;gap:0.5rem;align-items:start;`}>
        <dt style="font-size:0.7rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em;padding-top:0.15rem;font-family:var(--mono);">Network Affiliation</dt>
        <dd style="margin:0;display:flex;flex-wrap:wrap;gap:0.5rem;">
          {affiliationOrgs.map((org) => (
            <Badge href={`${base}/organizations/${slugFor(org.id)}`}>{getTitle(org)}</Badge>
          ))}
          {affiliationNames.map((name) => (
            <Badge>{name}</Badge>
          ))}
        </dd>
      </div>
    )}
    {tags.length > 0 && (
      <div style={`display:grid;grid-template-columns:${isPanel ? '100px' : '140px'} 1fr;gap:0.5rem;align-items:start;`}>
        <dt style="font-size:0.7rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em;padding-top:0.15rem;font-family:var(--mono);">Tags</dt>
        <dd style="margin:0;display:flex;flex-wrap:wrap;gap:0.5rem;">
          {tags.map((tag) => (
            <Badge shape="square" href={`${base}/ontology/${slugFor(tag.id)}`} icon={tag.icon}>{humanize(getTitle(tag))}</Badge>
          ))}
        </dd>
      </div>
    )}
  </dl>

  <hr style="border:none;border-top:1px solid var(--border);margin:2rem 0;" />

  {background && (
    <div style="margin-bottom:1.5rem;" set:html={renderMarkdown(background)} />
  )}

  {activities.length > 0 && (
    <div style="margin-bottom:1.5rem;">
      <h3 style={`font-size:${sectionHeadingSize};font-weight:500;margin:1.75rem 0 0.75rem 0;color:var(--fg);font-family:var(--sans);letter-spacing:-0.01em;`}>Activities</h3>
      <div style="display:flex;flex-direction:column;gap:1rem;">
        {activities.map((act) => {
          // Activities' relation to ontology tags is named "Ontology", not "Tags" (confirmed
          // against the live Notion schema) — every activity does have at least one, they just
          // weren't resolving under the wrong property name.
          const actTagIds: string[] = Array.isArray(act.properties['Ontology']) ? act.properties['Ontology'] : [];
          const actTags = actTagIds.map((id) => lookups.tags?.get(id)).filter(Boolean) as NormalizedRecord[];
          const actDescription = String(act.properties['Description'] ?? act.properties['description'] ?? '');
          return (
            <div style="padding:1rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
              <h4 style="margin:0 0 0.4rem 0;font-size:1.05rem;font-weight:500;font-family:var(--sans);line-height:1.3;word-break:break-word;overflow-wrap:anywhere;color:var(--fg);">{getTitle(act)}</h4>
              {actTags.length > 0 && (
                <div style="display:flex;flex-wrap:wrap;gap:0.35rem;margin-bottom:0.5rem;">
                  {actTags.map((tag) => (
                    <Badge size="sm" shape="square" icon={tag.icon}>{humanize(getTitle(tag))}</Badge>
                  ))}
                </div>
              )}
              {actDescription && (
                <p style="margin:0;font-size:0.85rem;color:var(--muted);line-height:1.55;">{actDescription}</p>
              )}
            </div>
          );
        })}
      </div>
    </div>
  )}

  {vision && (
    <div style="margin-bottom:1.5rem;" set:html={renderMarkdown(vision)} />
  )}

  {sources.length > 0 && (
    <div style="margin-bottom:1.5rem;">
      <h3 style={`font-size:${sectionHeadingSize};font-weight:500;margin:1.75rem 0 0.75rem 0;color:var(--fg);font-family:var(--sans);letter-spacing:-0.01em;`}>Sources</h3>
      <div style="overflow-x:auto;border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
        <table style="width:100%;border-collapse:collapse;font-size:0.9rem;">
          <thead>
            <tr style="border-bottom:1px solid var(--border);background:var(--surface);">
              <th style="text-align:left;padding:0.6rem 1rem;font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);font-weight:500;">Type</th>
              <th style="text-align:left;padding:0.6rem 1rem;font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);font-weight:500;">Name</th>
              <th style="text-align:left;padding:0.6rem 1rem;font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);font-weight:500;white-space:nowrap;">Source</th>
            </tr>
          </thead>
          <tbody>
            {sources.map((src) => {
              const sourceType = String(src.properties['Source type'] ?? src.properties['source type'] ?? '');
              const externalUrl = getUrl(src);
              const linkHref = externalUrl ?? `${base}/sources/${slugFor(src.id)}`;
              const linkLabel = externalUrl ? 'Visit source' : 'View source record';
              return (
                <tr style="border-bottom:1px solid var(--border);">
                  <td style="padding:0.5rem 1rem;white-space:nowrap;">
                    <Badge size="sm" icon={getSourceIcon(src)}>{sourceType}</Badge>
                  </td>
                  <td style="padding:0.5rem 1rem;color:var(--fg);font-weight:500;">{getTitle(src)}</td>
                  <td style="padding:0.5rem 1rem;">
                    <a href={linkHref} target={externalUrl ? '_blank' : undefined} rel={externalUrl ? 'noopener noreferrer' : undefined} style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:var(--radius);background:var(--umber);color:var(--paper-50);font-size:0.9rem;text-decoration:none;" aria-label={linkLabel} title={linkLabel}>
                      ↗
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  )}


</div>

---
import type { NormalizedRecord } from '../lib/notion';
import { humanize, toneForCategory } from '../lib/notion';
import Badge from './Badge.astro';

export interface Props {
  records: NormalizedRecord[];
  tagMap: Map<string, NormalizedRecord>;
  showHeader?: boolean;
  orgCount?: number;
  orgDescription?: string;
  // When true, embeds the map/gallery view toggle as the first item in the filters bar (home
  // page only) so toggle + filters read as one sticky header instead of a floating control and
  // a separate in-flow bar. Clicks call window.__beSetView (exposed by index.astro).
  viewToggle?: boolean;
}
const { records, tagMap, showHeader = true, orgCount, orgDescription = '', viewToggle = false } = Astro.props;
const base = import.meta.env.BASE_URL;

function getTitle(r: NormalizedRecord): string {
  return String(r.properties['Name'] ?? r.properties['Title'] ?? r.properties['name'] ?? r.properties['title'] ?? 'Untitled');
}

function getCategory(r: NormalizedRecord): string {
  return String(
    r.properties['Category'] ?? r.properties['category'] ??
    r.properties['Type'] ?? r.properties['type'] ?? ''
  );
}

function getPlace(r: NormalizedRecord): string {
  const place = r.properties['Place'] ?? r.properties['place'];
  if (place && typeof place === 'object') {
    if ('address' in place && place.address) return String(place.address);
    if ('name' in place && place.name) return String(place.name);
  }
  return String(
    r.properties['Scope'] ?? r.properties['scope'] ??
    r.properties['Comarca'] ?? r.properties['comarca'] ??
    r.properties['Location'] ?? r.properties['location'] ??
    place ?? ''
  );
}

function getDescription(r: NormalizedRecord): string {
  return String(r.properties['Description'] ?? r.properties['description'] ?? '');
}

interface TagRef { name: string; icon: string }

function getTags(r: NormalizedRecord): TagRef[] {
  const ids: string[] = Array.isArray(r.properties['Tags']) ? r.properties['Tags'] : [];
  return ids
    .map((id) => {
      const tag = tagMap.get(id);
      return tag ? { name: humanize(getTitle(tag)), icon: tag.icon ?? '' } : null;
    })
    .filter(Boolean) as TagRef[];
}

function isCaseStudy(r: NormalizedRecord): boolean {
  return String(r.properties['Case Study'] ?? r.properties['case study'] ?? '').toUpperCase() === 'Y';
}

const cards = records.map((r) => {
  const slug = r.id.replace(/-/g, '');
  return {
    id: r.id,
    slug,
    href: `${base}/organizations/${slug}`,
    name: getTitle(r),
    category: getCategory(r),
    place: getPlace(r),
    description: getDescription(r),
    tags: getTags(r),
    caseStudy: isCaseStudy(r),
  };
});

// Work Item F3: case-study cards first, then alphabetical by category within each group.
cards.sort((a, b) => {
  if (a.caseStudy !== b.caseStudy) return a.caseStudy ? -1 : 1;
  return a.category.localeCompare(b.category);
});

const categories = Array.from(new Set(cards.map((c) => c.category).filter(Boolean))).sort();
const allTags = Array.from(new Set(cards.flatMap((c) => c.tags.map((t) => t.name)))).sort();
const count = orgCount ?? cards.length;
---

<div id="org-gallery-root">
  {showHeader && (
    <header style="margin-bottom:1.5rem;">
      <h1 style="font-size:clamp(1.6rem, 3.2vw, 2.2rem);font-weight:500;margin:0 0 0.5rem 0;color:var(--fg);font-family:var(--sans);letter-spacing:-0.01em;">Organizations</h1>
      <p style="color:var(--muted);margin:0;font-size:1rem;max-width:640px;">Card gallery view.</p>
      <p style="color:var(--muted);margin:0.75rem 0 0 0;font-size:0.8rem;font-family:var(--mono);text-transform:uppercase;letter-spacing:0.04em;">{count} {orgDescription}</p>
    </header>
  )}

  <!-- Toolbar row: view toggle (when present) as its own box, flush left, immediately before
       the filters bar — a real flex sibling inside this same max-width column the card grid
       uses below, so the whole row (not a viewport-fixed offset) aligns with the cards on any
       screen width. Not sticky — sits in normal flow at the top like everything else. No
       wrapping border/background on the filters bar itself either: each control already has
       its own border via .field-control, so an outer box was just a second, redundant outline
       whose padding also pushed its contents' top edge below the toggle's. Removing it means
       every control's own top edge sits at the same row baseline as the toggle's. -->
  <div id="gallery-toolbar" style="display:flex;flex-wrap:wrap;align-items:center;margin-bottom:1.5rem;">
    <!-- No gap on the row itself — the toggle's own margin-right (index.astro) provides the
         gap only when it's actually docked here, so an empty anchor (toggle floating outside on
         wide screens) doesn't leave a phantom gap before the filters bar. -->
    {viewToggle && <div id="view-toggle-anchor" style="display:flex;flex-shrink:0;"></div>}
    <div id="gallery-filters" style="flex:1;min-width:0;display:flex;flex-wrap:wrap;gap:1.25rem;align-items:center;">
      <input
        id="gallery-search"
        type="text"
        placeholder="Search by name..."
        class="field-control"
        style="flex:0 1 320px;min-width:160px;"
      />
      <select id="gallery-filter-category" class="field-control">
        <option value="">All categories</option>
        {categories.map((c) => <option value={c}>{c}</option>)}
      </select>
      <div class="tag-filter-wrap" style="position:relative;">
        <button type="button" id="gallery-tags-toggle" class="field-control" style="cursor:pointer;white-space:nowrap;">
          Tags<span id="gallery-tags-count"></span>
        </button>
        <div id="gallery-tags-dropdown" style="display:none;position:absolute;top:calc(100% + 0.25rem);left:0;z-index:30;min-width:220px;max-height:280px;overflow-y:auto;background:var(--card);border:1px solid var(--umber);padding:0.5rem;box-shadow:0 4px 16px rgba(42,24,16,0.15);">
          {allTags.map((t) => (
            <label style="display:flex;align-items:center;gap:0.5rem;padding:0.3rem 0.25rem;font-size:0.8rem;color:var(--fg);cursor:pointer;">
              <input type="checkbox" class="gallery-tag-checkbox" value={t} />
              {t}
            </label>
          ))}
        </div>
      </div>
      <label style="display:flex;align-items:center;gap:0.4rem;font-size:0.75rem;font-family:var(--mono);text-transform:uppercase;letter-spacing:0.03em;color:var(--muted);white-space:nowrap;cursor:pointer;">
        <input type="checkbox" id="gallery-filter-case-study" />
        Case study only
      </label>
      <button id="gallery-filter-reset" class="field-control" style="color:var(--muted);font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.03em;cursor:pointer;">
        Reset
      </button>
    </div>
  </div>

  <!-- Card grid -->
  <div id="gallery-grid" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(280px, 1fr));gap:1rem;">
    {cards.map((c) => (
      <a
        href={c.href}
        class="gallery-card"
        data-id={c.id}
        data-name={c.name.toLowerCase()}
        data-category={c.category}
        data-tags={c.tags.map((t) => t.name).join('|')}
        data-case-study={c.caseStudy ? 'Y' : 'N'}
        style="display:flex;flex-direction:column;padding:1rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--card);text-decoration:none;color:var(--fg);transition:transform 0.15s ease,border-color 0.15s ease,box-shadow 0.15s ease;"
      >
        <div>
          {(c.category || c.caseStudy) && (
            <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;margin-bottom:0.75rem;">
              {c.category ? <Badge size="xs" tone={toneForCategory(c.category)}>{c.category}</Badge> : <span />}
              {c.caseStudy && (
                <span style="font-family:var(--mono);font-size:0.65rem;text-transform:uppercase;letter-spacing:0.04em;color:var(--muted);">Case study</span>
              )}
            </div>
          )}
          <h2 style="margin:0 0 0.5rem 0;font-size:1.15rem;font-weight:600;font-family:var(--sans);line-height:1.3;word-break:break-word;overflow-wrap:anywhere;">{c.name}</h2>
        </div>

        {c.place && (
          <div style="font-size:0.8rem;color:var(--muted);line-height:1.4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:0.75rem;">
            📍 {c.place}
          </div>
        )}

        {c.description && (
          <p style="margin:0 0 0.75rem 0;font-size:0.85rem;color:var(--muted);line-height:1.5;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;text-overflow:ellipsis;">
            {c.description}
          </p>
        )}

        {c.tags.length > 0 && (
          <div style="display:flex;flex-wrap:wrap;gap:0.4rem;margin-top:auto;">
            {c.tags.slice(0, 4).map((tag) => (
              <Badge size="sm" shape="square" icon={tag.icon}>{tag.name}</Badge>
            ))}
            {c.tags.length > 4 && (
              <Badge size="sm" shape="square">+{c.tags.length - 4}</Badge>
            )}
          </div>
        )}
      </a>
    ))}
  </div>

  <p id="gallery-empty" style="display:none;color:var(--muted);text-align:center;padding:3rem 1rem;font-size:0.9rem;">No organizations match your filters.</p>
</div>

<style>
  /* Work Item D3: filter inputs match the lab's .field__input pattern — square, umber-toned
     border at rest, terracotta focus ring. Needs a real class (not inline style) since inline
     styles can't express :focus-visible. Explicit height (not padding-derived) because <input>,
     <select>, and <button> each resolve padding+line-height to a different intrinsic height per
     their own UA defaults — measured 36/38/32px respectively before this fix — so a shared
     height + flex centering is used instead of relying on padding to produce equal heights. */
  .field-control {
    height: 2.25rem;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    padding: 0 0.75rem;
    border: 1px solid color-mix(in srgb, var(--umber) 45%, transparent);
    border-radius: 0;
    background: var(--surface);
    color: var(--fg);
    font-family: var(--sans);
    font-size: 0.85rem;
  }
  .field-control:focus-visible {
    outline: 2px solid var(--primary);
    border-color: var(--primary);
  }

  /* Work Item F1: CSS-only hover — the previous onmouseenter/onmouseleave inline-style pattern
     could get "stuck" if a mouseleave event was interrupted (fast pointer movement, touch,
     re-hydration). :hover can't get stuck the same way. */
  .gallery-card:hover {
    transform: translateY(-2px);
    border-color: var(--paper-200);
    box-shadow: 0 4px 20px rgba(42, 24, 16, 0.06);
  }
</style>

<script>
  (function () {
    const root = document.currentScript?.closest('#org-gallery-root') ?? document;
    const searchInput = root.querySelector('#gallery-search');
    const categorySelect = root.querySelector('#gallery-filter-category');
    const tagsToggle = root.querySelector('#gallery-tags-toggle');
    const tagsDropdown = root.querySelector('#gallery-tags-dropdown');
    const tagsCount = root.querySelector('#gallery-tags-count');
    const tagCheckboxes = root.querySelectorAll('.gallery-tag-checkbox');
    const caseStudyCheckbox = root.querySelector('#gallery-filter-case-study');
    const resetBtn = root.querySelector('#gallery-filter-reset');
    const cards = root.querySelectorAll('.gallery-card');
    const emptyMsg = root.querySelector('#gallery-empty');

    function selectedTags(): string[] {
      return Array.from(tagCheckboxes)
        .filter((cb) => (cb as HTMLInputElement).checked)
        .map((cb) => (cb as HTMLInputElement).value);
    }

    function applyFilters() {
      const query = (searchInput?.value ?? '').toLowerCase().trim();
      const category = categorySelect?.value ?? '';
      const tags = selectedTags();
      const caseStudyOnly = (caseStudyCheckbox as HTMLInputElement | null)?.checked ?? false;

      if (tagsCount) tagsCount.textContent = tags.length > 0 ? ` (${tags.length})` : '';

      let visible = 0;
      cards.forEach((card) => {
        const name = card.getAttribute('data-name') ?? '';
        const cardCategory = card.getAttribute('data-category') ?? '';
        const cardTags = (card.getAttribute('data-tags') ?? '').split('|').filter(Boolean);
        const cardCaseStudy = card.getAttribute('data-case-study') ?? 'N';

        const matchesSearch = !query || name.includes(query);
        const matchesCategory = !category || cardCategory === category;
        // Match-any: a card matching at least one selected tag passes (standard multi-tag filter
        // behavior — narrowing further to match-all would make combining tags mostly return
        // nothing, since few orgs share every tag).
        const matchesTags = tags.length === 0 || tags.some((t) => cardTags.includes(t));
        const matchesCaseStudy = !caseStudyOnly || cardCaseStudy === 'Y';

        const show = matchesSearch && matchesCategory && matchesTags && matchesCaseStudy;
        (card as HTMLElement).style.display = show ? '' : 'none';
        if (show) visible++;
      });

      if (emptyMsg) (emptyMsg as HTMLElement).style.display = visible === 0 ? 'block' : 'none';
    }

    searchInput?.addEventListener('input', applyFilters);
    categorySelect?.addEventListener('change', applyFilters);
    tagCheckboxes.forEach((cb) => cb.addEventListener('change', applyFilters));
    caseStudyCheckbox?.addEventListener('change', applyFilters);

    tagsToggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!tagsDropdown) return;
      (tagsDropdown as HTMLElement).style.display = (tagsDropdown as HTMLElement).style.display === 'none' ? 'block' : 'none';
    });
    document.addEventListener('click', (e) => {
      if (tagsDropdown && !(tagsDropdown as HTMLElement).contains(e.target as Node) && e.target !== tagsToggle) {
        (tagsDropdown as HTMLElement).style.display = 'none';
      }
    });

    resetBtn?.addEventListener('click', () => {
      if (searchInput) (searchInput as HTMLInputElement).value = '';
      if (categorySelect) (categorySelect as HTMLSelectElement).value = '';
      tagCheckboxes.forEach((cb) => ((cb as HTMLInputElement).checked = false));
      if (caseStudyCheckbox) (caseStudyCheckbox as HTMLInputElement).checked = false;
      applyFilters();
    });

    // Work Item E: welcome-sidebar theme badges dispatch this to pre-filter the gallery by tag.
    window.addEventListener('gallery-filter-tag', ((e: CustomEvent) => {
      const tag = e.detail?.tag;
      if (!tag) return;
      const cb = Array.from(tagCheckboxes).find((c) => (c as HTMLInputElement).value === tag) as HTMLInputElement | undefined;
      if (cb) cb.checked = true;
      applyFilters();
    }) as EventListener);

    // Work Item F2: card click opens the shared home-panel sidebar (HomeDetailPanel.astro),
    // which lives outside #map-view/#gallery-view so it isn't hidden by the view toggle — only
    // available on the home page, where that panel is rendered. On the standalone
    // /organizations page, clicks fall through to the card's normal href navigation.
    cards.forEach((card) => {
      card.addEventListener('click', (e: MouseEvent) => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const id = card.getAttribute('data-id');
        const bePanel = (window as any).__bePanel;
        if (id && bePanel?.showDetailById) {
          e.preventDefault();
          bePanel.showDetailById(id, card.getAttribute('data-name'));
        }
      });
    });
  })();
</script>

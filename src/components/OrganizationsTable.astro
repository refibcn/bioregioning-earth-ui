---
import type { NormalizedRecord } from '../lib/notion';
import OrgDetail from './OrgDetail.astro';

export interface Props {
  records: NormalizedRecord[];
  basePath?: string;
  lookups?: {
    tags?: Map<string, NormalizedRecord>;
    activities?: Map<string, NormalizedRecord>;
    sources?: Map<string, NormalizedRecord>;
    affiliations?: Map<string, NormalizedRecord>;
  };
}
const { records, basePath = '/', lookups = {} } = Astro.props;
const base = import.meta.env.BASE_URL;

function getTitle(r: NormalizedRecord): string {
  return String(r.properties['Name'] ?? r.properties['Title'] ?? r.properties['name'] ?? r.properties['title'] ?? 'Untitled');
}

function getType(r: NormalizedRecord): string {
  return String(
    r.properties['Category'] ??
    r.properties['category'] ??
    r.properties['Type'] ??
    r.properties['type'] ??
    ''
  );
}

function getPlace(r: NormalizedRecord): string {
  const place = r.properties['Place'] ?? r.properties['place'];
  if (place && typeof place === 'object') {
    if ('address' in place && place.address) return String(place.address);
    if ('latitude' in place && 'longitude' in place) return `${place.latitude}, ${place.longitude}`;
  }
  return String(
    r.properties['Scope'] ?? r.properties['scope'] ??
    r.properties['Comarca'] ?? r.properties['comarca'] ??
    r.properties['Location'] ?? r.properties['location'] ??
    place ?? ''
  );
}

function getDescription(r: NormalizedRecord): string {
  return String(r.properties['Description'] ?? r.properties['description'] ?? '');
}

function getUrl(r: NormalizedRecord): string | null {
  return (
    r.properties['URL'] ??
    r.properties['Url'] ??
    r.properties['url'] ??
    r.properties['Website'] ??
    r.properties['website'] ??
    null
  );
}

function getTagNames(r: NormalizedRecord): string[] {
  const ids: string[] = Array.isArray(r.properties['Tags']) ? r.properties['Tags'] : [];
  return ids
    .map((id) => {
      const tag = lookups.tags?.get(id);
      return tag ? getTitle(tag) : null;
    })
    .filter(Boolean) as string[];
}

function getIcon(r: NormalizedRecord): string {
  return r.icon ?? '';
}

function getCaseStudy(r: NormalizedRecord): string {
  return String(r.properties['Case Study'] ?? r.properties['case study'] ?? '');
}

const rows = records.map((r) => {
  const slug = r.id.replace(/-/g, '');
  const href = `${base}${basePath.replace(/\/$/, '')}/${slug}`;
  return {
    id: r.id,
    slug,
    href,
    name: getTitle(r),
    type: getType(r),
    place: getPlace(r),
    description: getDescription(r),
    url: getUrl(r),
    icon: getIcon(r),
    tags: getTagNames(r),
    caseStudy: getCaseStudy(r),
    record: r,
  };
});

const categories = Array.from(new Set(rows.map((r) => r.type).filter(Boolean))).sort();
const allTags = Array.from(new Set(rows.flatMap((r) => r.tags))).sort();
const hasLookups = Object.keys(lookups).length > 0;

const caseStudyOptions = [
  { value: '', label: 'All' },
  { value: 'Y', label: 'Case study' },
  { value: 'N', label: 'Not case study' },
];
---

<div id="org-table-root" style="position:relative;">
  <!-- Filter bar -->
  <div style="display:flex;flex-wrap:wrap;gap:0.75rem;margin-bottom:1rem;padding:0.75rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--card);align-items:center;">
    <input
      id="org-search"
      type="text"
      placeholder="Search organizations..."
      style="flex:1;min-width:180px;padding:0.5rem 0.75rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);color:var(--fg);font-family:var(--sans);font-size:0.85rem;"
    />
    <select
      id="org-filter-category"
      style="padding:0.5rem 0.75rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);color:var(--fg);font-family:var(--sans);font-size:0.85rem;"
    >
      <option value="">All categories</option>
      {categories.map((c) => <option value={c}>{c}</option>)}
    </select>
    <select
      id="org-filter-tags"
      style="padding:0.5rem 0.75rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);color:var(--fg);font-family:var(--sans);font-size:0.85rem;"
    >
      <option value="">All tags</option>
      {allTags.map((t) => <option value={t}>{t}</option>)}
    </select>
    <div style="display:flex;align-items:center;gap:0.4rem;">
      <span style="font-size:0.7rem;font-family:var(--mono);text-transform:uppercase;letter-spacing:0.03em;color:var(--muted);white-space:nowrap;">Case study</span>
      <select
        id="org-filter-case-study"
        style="padding:0.5rem 0.75rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);color:var(--fg);font-family:var(--sans);font-size:0.85rem;"
      >
        {caseStudyOptions.map((opt) => <option value={opt.value}>{opt.label}</option>)}
      </select>
    </div>
    <button
      id="org-filter-reset"
      style="padding:0.5rem 0.75rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);color:var(--muted);font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.03em;cursor:pointer;"
    >
      Reset
    </button>
  </div>

  <div style="overflow-x:auto;border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
    <table style="width:100%;border-collapse:collapse;font-size:0.9rem;table-layout:fixed;">
      <thead>
        <tr style="border-bottom:1px solid var(--border);background:var(--surface);">
          <th style="width:44px;text-align:left;padding:0.75rem 1rem;font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);font-weight:500;white-space:nowrap;">Icon</th>
          <th style="width:18%;text-align:left;padding:0.75rem 1rem;font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);font-weight:500;white-space:nowrap;">Name</th>
          <th style="width:54px;text-align:left;padding:0.75rem 1rem;font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);font-weight:500;white-space:nowrap;">Website</th>
          <th style="width:50%;text-align:left;padding:0.75rem 1rem;font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);font-weight:500;white-space:nowrap;">Description</th>
          <th style="width:12%;text-align:left;padding:0.75rem 1rem;font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);font-weight:500;white-space:nowrap;">Place</th>
          <th style="width:14%;text-align:left;padding:0.75rem 1rem;font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);font-weight:500;white-space:nowrap;">Tags</th>
          <th style="width:80px;text-align:left;padding:0.75rem 1rem;font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);font-weight:500;white-space:nowrap;">Case study</th>
          <th style="width:80px;text-align:left;padding:0.75rem 1rem;font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);font-weight:500;white-space:nowrap;">Full record</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr
            class="org-row"
            data-id={r.id}
            data-name={r.name.toLowerCase()}
            data-description={r.description.toLowerCase()}
            data-place={r.place.toLowerCase()}
            data-category={r.type}
            data-tags={r.tags.join('|')}
            data-case-study={r.caseStudy === 'Y' ? 'Y' : 'N'}
            style="border-bottom:1px solid var(--border);cursor:pointer;"
            onmouseenter="this.style.background='var(--surface)'"
            onmouseleave="this.style.background=''"
          >
            <td style="padding:0.6rem 1rem;font-size:1.1rem;line-height:1;">{r.icon}</td>
            <td style="padding:0.6rem 1rem;color:var(--fg);font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{r.name}</td>
            <td style="padding:0.6rem 1rem;">
              {r.url ? (
                <a
                  href={r.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={r.url}
                  style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:var(--radius);background:var(--surface);color:var(--primary);font-size:0.85rem;text-decoration:none;"
                  onclick="event.stopPropagation();"
                >
                  🌐
                </a>
              ) : (
                <span style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:var(--radius);color:var(--border);font-size:0.85rem;">—</span>
              )}
            </td>
            <td style="padding:0.6rem 1rem;color:var(--muted);font-size:0.85rem;">
              <span style="display:-webkit-box;-webkit-line-clamp:6;-webkit-box-orient:vertical;overflow:hidden;text-overflow:ellipsis;">
                {r.description}
              </span>
            </td>
            <td style="padding:0.6rem 1rem;color:var(--muted);font-size:0.85rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{r.place}</td>
            <td style="padding:0.6rem 1rem;color:var(--muted);font-size:0.85rem;">
              {r.tags.length > 0 ? (
                <div style="display:flex;flex-wrap:wrap;gap:0.25rem;">
                  {r.tags.slice(0, 2).map((tag) => (
                    <span style="font-size:0.65rem;padding:0.12rem 0.35rem;border-radius:var(--radius-pill);background:var(--accent);color:var(--accent-fg);border:1px solid var(--border);white-space:nowrap;font-family:var(--mono);text-transform:uppercase;letter-spacing:0.02em;">
                      {tag}
                    </span>
                  ))}
                  {r.tags.length > 2 && (
                    <span style="font-size:0.65rem;padding:0.12rem 0.35rem;border-radius:var(--radius-pill);background:var(--surface);color:var(--muted);border:1px solid var(--border);font-family:var(--mono);">+{r.tags.length - 2}</span>
                  )}
                </div>
              ) : (
                <span style="color:var(--border);">—</span>
              )}
            </td>
            <td style="padding:0.6rem 1rem;text-align:center;">
              {r.caseStudy === 'Y' ? (
                <span style="color:var(--success);font-size:1rem;" aria-label="Case study">✅</span>
              ) : (
                <span style="color:var(--border);font-size:0.85rem;">/</span>
              )}
            </td>
            <td style="padding:0.6rem 1rem;">
              <button
                class="org-view-btn"
                data-id={r.id}
                style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:var(--radius);background:var(--surface);color:var(--primary);font-size:0.9rem;border:none;padding:0;cursor:pointer;"
                aria-label="Open full record"
              >
                ↗
              </button>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {/* Hidden detail templates */}
  {hasLookups && (
    <div id="org-detail-templates" style="display:none;">
      {rows.map((r) => (
        <div id={`org-detail-${r.id}`} class="org-detail-template">
          <OrgDetail record={r.record} lookups={lookups} mode="panel" fullPageHref={r.href} />
        </div>
      ))}
    </div>
  )}

  <!-- Side panel -->
  <div
    id="org-side-panel"
    style="display:none;position:fixed;top:0;right:0;bottom:0;width:420px;max-width:40%;background:rgba(255,255,255,0.98);backdrop-filter:blur(12px);border-left:1px solid var(--border);overflow:hidden;box-shadow:-8px 0 32px rgba(42,24,16,0.12);font-family:var(--sans);z-index:100;flex-direction:column;"
  >
    <div style="display:flex;align-items:center;justify-content:space-between;padding:0.875rem 1.25rem;border-bottom:1px solid var(--border);flex-shrink:0;">
      <span style="font-size:0.7rem;font-family:var(--mono);text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);">Organization</span>
      <button id="org-panel-close" style="background:none;border:none;color:var(--muted);font-size:1.1rem;cursor:pointer;line-height:1;padding:0;" aria-label="Close panel">✕</button>
    </div>
    <div id="org-panel-content" style="padding:1.25rem;overflow-y:auto;flex:1;"></div>
  </div>
</div>

<script define:vars={{ hasLookups }}>
  (function () {
    if (!hasLookups) return;

    const panel = document.getElementById('org-side-panel');
    const panelContent = document.getElementById('org-panel-content');
    const panelClose = document.getElementById('org-panel-close');
    const searchInput = document.getElementById('org-search');
    const categorySelect = document.getElementById('org-filter-category');
    const tagsSelect = document.getElementById('org-filter-tags');
    const caseStudySelect = document.getElementById('org-filter-case-study');
    const resetBtn = document.getElementById('org-filter-reset');

    function openPanel(id) {
      if (!panel || !panelContent) return;
      const template = document.getElementById(`org-detail-${id}`);
      if (!template) return;
      panelContent.innerHTML = template.innerHTML;
      panel.style.display = 'flex';
      panelContent.scrollTop = 0;
    }

    function closePanel() {
      if (panel) panel.style.display = 'none';
    }

    panelClose?.addEventListener('click', closePanel);

    document.querySelectorAll('.org-row').forEach((row) => {
      row.addEventListener('click', () => {
        const id = row.getAttribute('data-id');
        if (id) openPanel(id);
      });
    });

    document.querySelectorAll('.org-view-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = btn.getAttribute('data-id');
        if (id) openPanel(id);
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closePanel();
    });

    function applyFilters() {
      const query = (searchInput?.value ?? '').toLowerCase().trim();
      const category = categorySelect?.value ?? '';
      const tag = tagsSelect?.value ?? '';
      const caseStudy = caseStudySelect?.value ?? '';

      document.querySelectorAll('.org-row').forEach((row) => {
        const name = row.getAttribute('data-name') ?? '';
        const description = row.getAttribute('data-description') ?? '';
        const place = row.getAttribute('data-place') ?? '';
        const rowCategory = row.getAttribute('data-category') ?? '';
        const rowTags = (row.getAttribute('data-tags') ?? '').split('|').filter(Boolean);
        const rowCaseStudy = row.getAttribute('data-case-study') ?? 'N';

        const matchesSearch = !query || name.includes(query);
        const matchesCategory = !category || rowCategory === category;
        const matchesTag = !tag || rowTags.includes(tag);
        const matchesCaseStudy = !caseStudy || rowCaseStudy === caseStudy;

        row.style.display = (matchesSearch && matchesCategory && matchesTag && matchesCaseStudy) ? '' : 'none';
      });
    }

    searchInput?.addEventListener('input', applyFilters);
    categorySelect?.addEventListener('change', applyFilters);
    tagsSelect?.addEventListener('change', applyFilters);
    caseStudySelect?.addEventListener('change', applyFilters);
    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (categorySelect) categorySelect.value = '';
      if (tagsSelect) tagsSelect.value = '';
      if (caseStudySelect) caseStudySelect.value = '';
      applyFilters();
    });
  })();
</script>

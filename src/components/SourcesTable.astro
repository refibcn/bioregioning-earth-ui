---
import type { NormalizedRecord } from '../lib/notion';

export interface Props {
  records: NormalizedRecord[];
  basePath?: string;
  relatedOrgs?: NormalizedRecord[];
}
const { records, basePath = '/', relatedOrgs = [] } = Astro.props;
const base = import.meta.env.BASE_URL;

function getTitle(r: NormalizedRecord): string {
  return String(r.properties['Name'] ?? r.properties['Title'] ?? r.properties['name'] ?? r.properties['title'] ?? 'Untitled');
}

function getSourceType(r: NormalizedRecord): string {
  return String(r.properties['Source type'] ?? r.properties['Source Type'] ?? r.properties['source_type'] ?? r.properties['source type'] ?? r.properties['Type'] ?? r.properties['type'] ?? '');
}

function getDescription(r: NormalizedRecord): string {
  return String(r.properties['Description'] ?? r.properties['description'] ?? '');
}

function emojiForSourceType(type: string): string {
  const t = type.toLowerCase().trim();
  if (!t) return '📄';
  if (t.includes('report')) return '📊';
  if (t.includes('article')) return '📄';
  if (t.includes('essay')) return '📝';
  if (t.includes('book')) return '📚';
  if (t.includes('video')) return '🎥';
  if (t.includes('podcast')) return '🎙️';
  if (t.includes('website')) return '🌐';
  if (t.includes('tool')) return '🛠️';
  if (t.includes('case study') || t.includes('case-study')) return '📋';
  if (t.includes('talk') || t.includes('presentation')) return '🎤';
  if (t.includes('whitepaper') || t.includes('white paper')) return '📑';
  if (t.includes('guide') || t.includes('handbook')) return '🧭';
  if (t.includes('course')) return '🎓';
  if (t.includes('dataset') || t.includes('data')) return '🗂️';
  if (t.includes('map')) return '🗺️';
  if (t.includes('paper') || t.includes('research')) return '📑';
  if (t.includes('blog')) return '📰';
  if (t.includes('newsletter')) return '📧';
  return '📄';
}

const rows = records.map((r) => {
  const slug = r.id.replace(/-/g, '');
  const href = `${base}${basePath.replace(/\/$/, '')}/${slug}`;
  const linkedOrgs = relatedOrgs.filter((org) => {
    const sourceIds = org.properties['Sources'];
    return Array.isArray(sourceIds) && sourceIds.includes(r.id);
  });
  return {
    record: r,
    slug,
    href,
    title: getTitle(r),
    type: getSourceType(r),
    emoji: emojiForSourceType(getSourceType(r)),
    description: getDescription(r),
    linkedOrgs,
  };
});
---

<div style="overflow-x:auto;border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
  <table style="width:100%;border-collapse:collapse;font-size:0.9rem;">
    <thead>
      <tr style="border-bottom:1px solid var(--border);background:var(--surface);">
        <th style="text-align:left;padding:0.75rem 1rem;font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);font-weight:500;">Type</th>
        <th style="text-align:left;padding:0.75rem 1rem;font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);font-weight:500;">Name</th>
        <th style="text-align:left;padding:0.75rem 1rem;font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);font-weight:500;">Description</th>
        <th style="text-align:left;padding:0.75rem 1rem;font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);font-weight:500;">Organizations</th>
        <th style="text-align:left;padding:0.75rem 1rem;font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);font-weight:500;white-space:nowrap;">Full record</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr style="border-bottom:1px solid var(--border);">
          <td style="padding:0.6rem 1rem;color:var(--muted);white-space:nowrap;">
            <span style="margin-right:0.35rem;">{r.emoji}</span>
            <span style="font-size:0.8rem;font-family:var(--mono);text-transform:uppercase;letter-spacing:0.02em;">{r.type}</span>
          </td>
          <td style="padding:0.6rem 1rem;color:var(--fg);font-weight:500;">
            <a href={r.href} style="color:var(--fg);text-decoration:none;">{r.title}</a>
          </td>
          <td style="padding:0.6rem 1rem;color:var(--muted);font-size:0.85rem;max-width:320px;">
            <span style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;text-overflow:ellipsis;">
              {r.description}
            </span>
          </td>
          <td style="padding:0.6rem 1rem;">
            {r.linkedOrgs.length > 0 ? (
              <div style="display:flex;flex-wrap:wrap;gap:0.35rem;">
                {r.linkedOrgs.map((org) => (
                  <a href={`${base}/organizations/${org.id.replace(/-/g, '')}`} style="font-size:0.78rem;padding:0.15rem 0.5rem;border-radius:var(--radius-pill);background:var(--surface);border:1px solid var(--border);color:var(--fg);text-decoration:none;white-space:nowrap;">
                    {org.icon || '•'} {getTitle(org)}
                  </a>
                ))}
              </div>
            ) : (
              <span style="color:var(--border);font-size:0.85rem;">—</span>
            )}
          </td>
          <td style="padding:0.6rem 1rem;">
            <a href={r.href} style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:var(--radius);background:var(--surface);color:var(--primary);font-size:0.9rem;text-decoration:none;" aria-label="Open full record">
              ↗
            </a>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

---
import type { NormalizedRecord } from '../lib/notion';
import { getUrl, getCategory, toneForCategory } from '../lib/notion';
import Badge from './Badge.astro';

export interface Props {
  records: NormalizedRecord[];
  basePath?: string;
  relatedOrgs?: NormalizedRecord[];
}
const { records, basePath = '/', relatedOrgs = [] } = Astro.props;
const base = import.meta.env.BASE_URL;

function getTitle(r: NormalizedRecord): string {
  return String(r.properties['Name'] ?? r.properties['Title'] ?? r.properties['name'] ?? r.properties['title'] ?? 'Untitled');
}

function getSourceType(r: NormalizedRecord): string {
  return String(r.properties['Source type'] ?? r.properties['Source Type'] ?? r.properties['source_type'] ?? r.properties['source type'] ?? r.properties['Type'] ?? r.properties['type'] ?? '');
}

function getDescription(r: NormalizedRecord): string {
  return String(r.properties['Description'] ?? r.properties['description'] ?? '');
}

function emojiForSourceType(type: string): string {
  const t = type.toLowerCase().trim();
  if (!t) return '📄';
  if (t.includes('report')) return '📊';
  if (t.includes('article')) return '📄';
  if (t.includes('essay')) return '📝';
  if (t.includes('book')) return '📚';
  if (t.includes('video')) return '🎥';
  if (t.includes('podcast')) return '🎙️';
  if (t.includes('website')) return '🌐';
  if (t.includes('tool')) return '🛠️';
  if (t.includes('case study') || t.includes('case-study')) return '📋';
  if (t.includes('talk') || t.includes('presentation')) return '🎤';
  if (t.includes('whitepaper') || t.includes('white paper')) return '📑';
  if (t.includes('guide') || t.includes('handbook')) return '🧭';
  if (t.includes('course')) return '🎓';
  if (t.includes('dataset') || t.includes('data')) return '🗂️';
  if (t.includes('map')) return '🗺️';
  if (t.includes('paper') || t.includes('research')) return '📑';
  if (t.includes('blog')) return '📰';
  if (t.includes('newsletter')) return '📧';
  return '📄';
}

const rows = records.map((r) => {
  const slug = r.id.replace(/-/g, '');
  const href = `${base}${basePath.replace(/\/$/, '')}/${slug}`;
  const linkedOrgs = relatedOrgs.filter((org) => {
    const sourceIds = org.properties['Sources'];
    return Array.isArray(sourceIds) && sourceIds.includes(r.id);
  });
  const externalUrl = getUrl(r);
  return {
    record: r,
    slug,
    href,
    externalUrl,
    linkHref: externalUrl ?? href,
    linkLabel: externalUrl ? 'Visit source' : 'View source record',
    title: getTitle(r),
    type: getSourceType(r),
    emoji: emojiForSourceType(getSourceType(r)),
    description: getDescription(r),
    linkedOrgs,
  };
});
---

<div style="overflow-x:auto;border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
  <table style="width:100%;min-width:800px;border-collapse:collapse;font-size:0.9rem;table-layout:fixed;">
    <thead>
      <tr style="border-bottom:1px solid var(--border);background:var(--surface);">
        <th style="width:9%;text-align:left;padding:0.75rem 1rem;font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);font-weight:500;">Type</th>
        <th style="width:16%;text-align:left;padding:0.75rem 1rem;font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);font-weight:500;">Name</th>
        <th style="width:37%;text-align:left;padding:0.75rem 1rem;font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);font-weight:500;">Description</th>
        <th style="width:29%;text-align:left;padding:0.75rem 1rem;font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);font-weight:500;">Organizations</th>
        <th style="width:9%;text-align:left;padding:0.75rem 1rem;font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);font-weight:500;white-space:nowrap;">Source</th>
      </tr>
    </thead>
    <tbody style="overflow:hidden;background:var(--card);">
      {rows.map((r) => (
        <tr style="border-bottom:1px solid var(--border);overflow:hidden;">
          <td style="padding:0.6rem 1rem;overflow:hidden;text-overflow:ellipsis;vertical-align:top;">
            <Badge size="sm" icon={r.emoji}>{r.type}</Badge>
          </td>
          <td style="padding:0.6rem 1rem;color:var(--fg);font-weight:500;overflow-wrap:anywhere;vertical-align:top;">
            <a href={r.href} style="color:var(--fg);text-decoration:none;">{r.title}</a>
          </td>
          <td style="padding:0.6rem 1rem;color:var(--muted);font-size:0.85rem;overflow:hidden;vertical-align:top;">
            <span style="display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;text-overflow:ellipsis;">
              {r.description}
            </span>
          </td>
          <td style="padding:0.6rem 1rem;overflow:hidden;vertical-align:top;">
            {r.linkedOrgs.length > 0 ? (
              <div style="display:flex;flex-wrap:wrap;gap:0.35rem;">
                {r.linkedOrgs.map((org) => (
                  <Badge size="sm" tone={toneForCategory(getCategory(org))} href={`${base}/organizations/${org.id.replace(/-/g, '')}`}>{getTitle(org)}</Badge>
                ))}
              </div>
            ) : (
              <span style="color:var(--border);font-size:0.85rem;">—</span>
            )}
          </td>
          <td style="padding:0.6rem 1rem;overflow:hidden;vertical-align:top;">
            <a href={r.linkHref} target={r.externalUrl ? '_blank' : undefined} rel={r.externalUrl ? 'noopener noreferrer' : undefined} style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:0;background:var(--umber);color:var(--paper-50);font-size:0.9rem;text-decoration:none;" aria-label={r.linkLabel} title={r.linkLabel}>
              ↗
            </a>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

---
export interface Props {
  title?: string;
  description?: string;
  hideFooter?: boolean;
}
const { title, description, hideFooter = false } = Astro.props;
const siteTitle = 'Bioregioning Earth';
const pageTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        /* ReFi BCN brand resync (2026-08-11) — token names unchanged (everything below
           threads through inline styles across every component here), values retargeted
           to match refibcn.github.io's actual live palette
           (src/styles/themes/editorial-organic.css). This file was still on the original
           2026-06-02 three-pillar lock; refibcn relocked the pillar ramps and moved
           --primary off the flow pillar onto a dedicated --terracotta, both on 2026-08-07 —
           neither change had made it here. */
        --paper-50: #fffffd;   /* was #F5F5F5 — refibcn's --paper */
        --paper-100: #f8f4ed;  /* was #F1F0EE — refibcn's --ivory (surface-2) */
        --paper-200: #DDD7CF;  /* unchanged — already ~equal to refibcn's --border-subtle rendered on paper */
        --paper-700: color-mix(in srgb, var(--paper-900) 65%, var(--paper-50) 35%); /* was a fixed #41312A (too dark to read as "muted"); now derived the same way refibcn derives --rule/--text-muted, so it tracks --paper-900/50 automatically */
        --paper-900: #221a12;  /* was #2A1810 — refibcn's --umber */

        --terracotta: #D12B00; /* refibcn's brand primary anchor (2026-08-07) — didn't exist here before */

        --pillar-neural-1: #4DEFFF; --pillar-neural-4: #0055FF; --pillar-neural-6: #000FA0;
        --pillar-tissue-1: #D9FF4A; --pillar-tissue-4: #6DBF23; --pillar-tissue-6: #2C5A0D;
        --pillar-flow-1: #FFBB26;   --pillar-flow-4: #FF5500;   --pillar-flow-6: #8A2200;

        --bg: var(--paper-50);
        --surface: var(--paper-100);
        --card: #FFFFFF;
        --border: var(--paper-200);
        --fg: var(--paper-900);
        --muted: var(--paper-700);
        --primary: var(--terracotta);                                          /* was pillar-flow-4 — refibcn moved primary off the flow pillar 2026-08-07, partly to fix a contrast failure the flow-orange primary had */
        --primary-hover: color-mix(in srgb, var(--terracotta) 82%, black 18%);  /* was pillar-flow-6 */
        --primary-fg: #FFFFFF;                                                  /* was paper-900 (dark) — terracotta needs light text, not dark; matches refibcn's paper-on-primary */
        --accent: var(--pillar-neural-1);
        --accent-fg: var(--pillar-neural-6);
        --success: var(--pillar-tissue-6);  /* was a standalone #214033 — refibcn derives success from tissue-dark */
        --warning: var(--pillar-flow-1);    /* new — refibcn derives warning from flow-light; wasn't defined here at all */
        --danger: #7A2618;                  /* new — refibcn's fixed brick red, distinct from primary; wasn't defined here at all */
        --info: var(--pillar-neural-4);     /* was a standalone #598FFD — refibcn derives info from neural-mid */

        --radius: 0.5rem;
        --radius-sm: 0.25rem;
        --radius-pill: 9999px;
        --max-w: 1280px;

        --sans: "Geist", system-ui, -apple-system, "Segoe UI", sans-serif;
        --mono: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, monospace; /* briefly changed to IBM Plex Mono during the 2026-08-11 resync, matching what refibcn.github.io had at the time — refibcn corrected that same day (IBM Plex Mono → Geist Mono), so this reverts to match */
        /* No --serif token — Averia is ReFi BCN's own display face (refibcn.github.io and other
           surfaces the org owns), not something client/partner surfaces inherit. This site isn't
           refibcn-owned, so it doesn't get the display face at all, not even for hero/page-opening
           headings the way refibcn's own site uses it — those just stay --sans here. See
           refibcn.github.io's Typography page for the rule this follows. */
      }
      * { box-sizing: border-box; }
      html, body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: var(--sans);
        line-height: 1.55;
      }
      a { color: var(--primary); text-decoration: none; }
      a:hover { text-decoration: underline; }
      ::selection { background: var(--accent); color: var(--fg); }
    </style>
  </head>
  <body>
    <nav style="position:sticky;top:0;z-index:50;background:rgba(245,245,245,0.92);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);">
      <div style="width:100%;padding:0 1.5rem;display:flex;align-items:center;justify-content:space-between;height:48px;gap:1rem;">
        <a href={`${base}/`} style="font-weight:600;font-size:0.95rem;color:var(--fg);white-space:nowrap;font-family:var(--sans);">🌱 {siteTitle}</a>
        <div style="display:flex;gap:1.25rem;flex-wrap:wrap;justify-content:flex-end;align-items:center;font-family:var(--mono);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.03em;">
          <a href={`${base}/`} style="color:var(--muted);">Organizations</a>
          <span style="color:var(--border);font-size:0.9rem;">·</span>
          <a href={`${base}/ontology`} style="color:var(--muted);">Ontology</a>
          <span style="color:var(--border);font-size:0.9rem;">·</span>
          <a href={`${base}/sources`} style="color:var(--muted);">Sources</a>
          <span style="color:var(--border);font-size:0.9rem;">·</span>
          <a href={`${base}/how-to-explore`} style="color:var(--muted);">How to Explore</a>
          <span style="color:var(--border);font-size:0.9rem;">·</span>
          <a href={`${base}/about`} style="color:var(--muted);">About</a>
        </div>
      </div>
    </nav>
    <slot />
    {!hideFooter && (
      <footer style="border-top:1px solid var(--border);margin-top:4rem;padding:2rem 1.5rem;text-align:center;color:var(--muted);font-size:0.8rem;font-family:var(--mono);text-transform:uppercase;letter-spacing:0.04em;">
        <div style="max-width:var(--max-w);margin:0 auto;display:flex;flex-wrap:wrap;justify-content:center;gap:1rem;align-items:center;">
          <a href="https://refibcn.cat/" target="_blank" rel="noopener noreferrer" style="color:var(--muted);text-decoration:none;">ReFi Barcelona</a>
          <span style="color:var(--border);">·</span>
          <a href="https://www.r3-0.org/" target="_blank" rel="noopener noreferrer" style="color:var(--muted);text-decoration:none;">r3.0</a>
          <span style="color:var(--border);">·</span>
          <a href="mailto:hola@refibcn.cat" style="color:var(--muted);text-decoration:none;">hola@refibcn.cat</a>
        </div>
      </footer>
    )}
  </body>
</html>

---
import Layout from '../../layouts/Layout.astro';
import NetworkSection from '../../components/NetworkSection.astro';
import OntologyGallery from '../../components/OntologyGallery.astro';
import SourcesTable from '../../components/SourcesTable.astro';
import OrganizationsGallery from '../../components/OrganizationsGallery.astro';
import EarthMap from '../../components/EarthMap.astro';
import { loadSectionConfig, loadRelatedDatabases, fetchSectionRecords, fetchDatabaseRecords, fetchActivitiesRecords, fetchPageBlocks, renderBlocksToHtml, buildRecordMap } from '../../lib/notion';
import { hasCoords } from '../../lib/geo';
import { splitBlocksByHeadings } from '../../lib/ontology';

type OntologyPageContent = { intro: string; ontology: string; activities: string };
const EMPTY_ONTOLOGY_CONTENT: OntologyPageContent = { intro: '', ontology: '', activities: '' };

export async function getStaticPaths() {
  const sections = loadSectionConfig();
  return sections.map((s) => ({
    params: { section: s.route.replace(/^\//, '') },
    props: { section: s },
  }));
}

const { section } = Astro.props;
const records = await fetchSectionRecords(section);
const base = import.meta.env.BASE_URL;

const isOrgs = section.id === 'bioregional-organizations';
const isOntology = section.id === 'ontology';
const isSources = section.id === 'sources';

let lookups = { tags: new Map(), activities: new Map(), sources: new Map(), affiliations: new Map() };
let ontologyLookups = { activities: new Map(), organizations: new Map(), sources: new Map() };
let relatedOrgs: NormalizedRecord[] = [];

const sections = loadSectionConfig();
const related = loadRelatedDatabases();
const sourcesSection = sections.find((s) => s.id === 'sources');
const ontologySection = sections.find((s) => s.id === 'ontology');
const orgsSection = sections.find((s) => s.id === 'bioregional-organizations');

const [allSources, allOntology, allActivities, allOrgs] = await Promise.all([
  sourcesSection?.database_id ? fetchDatabaseRecords(sourcesSection.database_id) : Promise.resolve([]),
  ontologySection?.database_id ? fetchDatabaseRecords(ontologySection.database_id) : Promise.resolve([]),
  related.activities ? fetchActivitiesRecords() : Promise.resolve([]),
  orgsSection?.database_id ? fetchDatabaseRecords(orgsSection.database_id) : Promise.resolve([]),
]);

if (isOrgs) {
  lookups = {
    tags: buildRecordMap(allOntology),
    activities: buildRecordMap(allActivities),
    sources: buildRecordMap(allSources),
    affiliations: buildRecordMap(records),
  };
}

if (isSources) {
  relatedOrgs = allOrgs;
}

let ontologyPageContents: Record<string, OntologyPageContent> = {};

if (isOntology) {
  ontologyLookups = {
    activities: buildRecordMap(allActivities),
    organizations: buildRecordMap(allOrgs),
    sources: buildRecordMap(allSources),
  };
  // Fetch page body content for ontology parent items so side panels can show it, split into
  // intro plus each "Ontology"/"Activities" heading section — see splitBlocksByHeadings.
  for (const r of records) {
    try {
      const blocks = await fetchPageBlocks(r.id);
      const { intro, sections } = splitBlocksByHeadings(blocks, ['Ontology', 'Activities']);
      ontologyPageContents[r.id] = {
        intro: await renderBlocksToHtml(intro),
        ontology: await renderBlocksToHtml(sections['ontology'] ?? []),
        activities: await renderBlocksToHtml(sections['activities'] ?? []),
      };
    } catch (e) {
      ontologyPageContents[r.id] = { ...EMPTY_ONTOLOGY_CONTENT };
    }
  }
}

const hasMapData = records.some((r) => hasCoords(r.properties));
---

<Layout title={section.name} description={section.description}>
  <main style="max-width:var(--max-w);margin:0 auto;padding:2rem 1.5rem;">
    <a href={`${base}/`} style="display:inline-block;font-size:0.8rem;color:var(--muted);margin-bottom:1.25rem;text-decoration:none;font-family:var(--mono);text-transform:uppercase;letter-spacing:0.04em;">← Back to Dashboard</a>

    <header style="margin-bottom:2rem;">
      <h1 style="font-size:clamp(1.6rem, 3.2vw, 2.2rem);font-weight:500;margin:0 0 0.5rem 0;color:var(--fg);font-family:var(--sans);letter-spacing:-0.01em;">{section.name}</h1>
      <p style="color:var(--muted);margin:0;font-size:1rem;max-width:640px;">{section.description}</p>
      {!isSources && !isOntology && (
        <p style="color:var(--muted);margin:0.75rem 0 0 0;font-size:0.8rem;font-family:var(--mono);text-transform:uppercase;letter-spacing:0.04em;">{records.length} records</p>
      )}
    </header>

    {hasMapData && (
      <section style="margin-bottom:2.5rem;">
        <EarthMap records={records} basePath={section.route} lookups={lookups} />
      </section>
    )}

    <!-- Gallery view for Organizations -->
    {isOrgs && (
      <section style="margin-bottom:2.5rem;">
        <OrganizationsGallery records={records} tagMap={buildRecordMap(allOntology)} orgCount={records.length} orgDescription="Bioregional actors and initiatives currently mapped" />
      </section>
    )}

    <!-- Section-specific views -->
    {isOntology && <OntologyGallery records={records} basePath={section.route} lookups={ontologyLookups} pageContents={ontologyPageContents} />}
    {isSources && <SourcesTable records={records} basePath={section.route} relatedOrgs={relatedOrgs} />}
    {!isOrgs && !isOntology && !isSources && <NetworkSection records={records} basePath={section.route} />}
  </main>
</Layout>
